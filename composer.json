{
    "name": "mirivlad/monitoring-system",
    "description": "Система мониторинга серверов",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "slim/slim": "^4.15.2",
        "slim/psr7": "^1.8",
        "slim/twig-view": "^3.4",
        "twig/twig": "^3.28",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-curl": "*",
        "ext-sodium": "*",
        "slim/csrf": "^1.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse",
            "composer validate --strict",
            "composer audit"
        ]
    },
    "config": {
        "process-timeout": 0,
        "platform-check": false,
        "sort-packages": true,
        "platform": {
            "php": "8.5.8"
        }
    }
}
