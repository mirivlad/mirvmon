# Portainer stack variables (do not commit real values)
# SMTP and Telegram are deliberately absent: those settings live in
# /admin/notifications, encrypted in the database, and are never read from the
# environment.
MIRVMON_IMAGE=ghcr.io/mirivlad/mirvmon:0.6.6
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=UTC
APP_CPUS=2.0
APP_MEMORY_LIMIT=512m
PUBLIC_BASE_URL=
TRUSTED_PROXIES=private_ranges
SESSION_SECURE=1
APP_KEY=
SETUP_TOKEN=
DB_NAME=mirvmon
DB_USERNAME=mirvmon
DB_PASSWORD=
DB_CPUS=2.0
DB_MEMORY_LIMIT=2g
DB_STARTUP_ATTEMPTS=60
OFFLINE_CHECK_INTERVAL=15
CONNECTIVITY_CHECK_INTERVAL=15
CONNECTIVITY_PROBE_TIMEOUT=1.0
CONNECTIVITY_PROBE_QUORUM=2
CONNECTIVITY_PROBE_TARGETS=one.one.one.one:443,dns.google:443,dns.quad9.net:443
WEBSITE_CHECK_LOOP_INTERVAL=15
NOTIFICATION_POLL_INTERVAL=2
NOTIFICATION_BATCH_SIZE=20
DR_WORKER_INTERVAL=2
BACKUP_MAX_UPLOAD_BYTES=8589934592
NOTIFICATION_SENT_RETENTION_DAYS=7
NOTIFICATION_DEAD_RETENTION_DAYS=30
