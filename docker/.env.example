# Portainer stack variables (do not commit real values)
# SMTP and Telegram are deliberately absent: those settings live in
# /admin/notifications, encrypted in the database, and are never read from the
# environment.
MIRVMON_IMAGE=ghcr.io/mirivlad/mirvmon:0.2.5
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=UTC
APP_CPUS=2.0
APP_MEMORY_LIMIT=512m
PUBLIC_BASE_URL=
TRUSTED_PROXIES=private_ranges
SESSION_SECURE=1
APP_KEY=
SETUP_TOKEN=
DB_NAME=mirvmon
DB_USERNAME=mirvmon
DB_PASSWORD=
DB_CPUS=2.0
DB_MEMORY_LIMIT=2g
DB_STARTUP_ATTEMPTS=60
OFFLINE_CHECK_INTERVAL=15
NOTIFICATION_POLL_INTERVAL=2
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_SENT_RETENTION_DAYS=7
NOTIFICATION_DEAD_RETENTION_DAYS=30
