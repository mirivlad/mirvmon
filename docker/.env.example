# Portainer stack variables (do not commit real values)
MIRVMON_IMAGE=ghcr.io/mirivlad/mirvmon:latest
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=UTC
APP_CPUS=2.0
APP_MEMORY_LIMIT=512m
PUBLIC_BASE_URL=
TRUSTED_PROXIES=private_ranges
APP_KEY=
SETUP_TOKEN=
DB_NAME=mirvmon
DB_USERNAME=mirvmon
DB_PASSWORD=
DB_CPUS=2.0
DB_MEMORY_LIMIT=2g
OFFLINE_CHECK_INTERVAL=15
NOTIFICATION_POLL_INTERVAL=2
NOTIFICATION_BATCH_SIZE=20
