#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Backup\DrMaintenanceLock;
use App\Database\ConnectionFactory;
use App\Repositories\AppSettingsRepository;
use App\Repositories\ConnectivityStateRepository;
use App\Repositories\NotificationOutboxRepository;
use App\Repositories\WorkerHeartbeatRepository;
use App\Services\ConnectivitySettingsService;
use App\Workers\OfflineStatusWorker;

require dirname(__DIR__) . '/vendor/autoload.php';

$interval = filter_var(
    getenv('OFFLINE_CHECK_INTERVAL') ?: 15,
    FILTER_VALIDATE_INT,
    ['options' => ['min_range' => 5, 'max_range' => 300]]
);
if ($interval === false) {
    fwrite(STDERR, "OFFLINE_CHECK_INTERVAL must be between 5 and 300 seconds.\n");
    exit(1);
}


$once = in_array('--once', $argv, true);
$running = true;
if (function_exists('pcntl_async_signals') && function_exists('pcntl_signal')) {
    pcntl_async_signals(true);
    pcntl_signal(SIGTERM, static function () use (&$running): void {
        $running = false;
    });
    pcntl_signal(SIGINT, static function () use (&$running): void {
        $running = false;
    });
}

$runtime = null;
$maintenance = new DrMaintenanceLock(dirname(__DIR__) . '/var/dr');

do {
    $lease = $maintenance->acquireShared();
    if ($lease !== null) {
        try {
            $runtime ??= createOfflineRuntime();
            $now = new DateTimeImmutable();
            if (!$runtime['startup_checked']) {
                $lastTickAt = $runtime['heartbeat']->lastTickAt(
                    WorkerHeartbeatRepository::OFFLINE_WORKER
                );
                $gapThreshold = max(
                    WorkerHeartbeatRepository::STALE_AFTER_SECONDS,
                    $interval * 3
                );
                if (
                    $lastTickAt === null
                    || $now->getTimestamp() - $lastTickAt->getTimestamp() > $gapThreshold
                ) {
                    $runtime['worker']->beginObservationRecovery($now);
                    fwrite(STDERR, "offline_worker_observation_recovery\n");
                }
                $runtime['startup_checked'] = true;
            }
            $connectivityConfig = $runtime['connectivity_config']->current();
            $connectivityFreshSeconds = max(
                60,
                min(1200, $connectivityConfig['interval_seconds'] * 4)
            );
            $connectivityState = $runtime['connectivity']->freshState(
                $now,
                $connectivityFreshSeconds
            );
            if (
                $runtime['last_connectivity_state'] === 'offline'
                && $connectivityState === 'online'
            ) {
                $runtime['worker']->beginObservationRecovery($now);
                fwrite(STDERR, "offline_worker_connectivity_recovered\n");
            }
            if (
                $connectivityState === 'offline'
                && $runtime['last_connectivity_state'] !== 'offline'
            ) {
                fwrite(STDERR, "offline_worker_connectivity_lost\n");
            }
            if ($connectivityState !== 'unknown') {
                $runtime['last_connectivity_state'] = $connectivityState;
            }

            $runtime['worker']->runOnce($now, $connectivityState !== 'offline');
            $runtime['heartbeat']->record(WorkerHeartbeatRepository::OFFLINE_WORKER);
        } catch (PDOException) {
            fwrite(STDERR, "offline_worker_database_unavailable\n");
            $runtime = null;
            if ($once) {
                $lease->release();
                exit(1);
            }
        } catch (Throwable $exception) {
            fwrite(
                STDERR,
                'offline_worker_failed:' . $exception::class . PHP_EOL
            );
            $lease->release();
            exit(1);
        } finally {
            $lease->release();
        }
    }

    if ($once) {
        break;
    }
    for ($second = 0; $second < $interval && $running; $second++) {
        sleep(1);
    }
} while ($running);

/**
 * @return array{worker: OfflineStatusWorker, heartbeat: WorkerHeartbeatRepository, connectivity: ConnectivityStateRepository, connectivity_config: ConnectivitySettingsService, startup_checked: bool, last_connectivity_state: string}
 */
function createOfflineRuntime(): array
{
    $pdo = ConnectionFactory::fromEnvironment();
    $settings = new AppSettingsRepository($pdo);

    return [
        'worker' => new OfflineStatusWorker(
            $pdo,
            new NotificationOutboxRepository($pdo)
        ),
        'heartbeat' => new WorkerHeartbeatRepository($pdo),
        'connectivity' => new ConnectivityStateRepository($settings),
        'connectivity_config' => new ConnectivitySettingsService($settings),
        'startup_checked' => false,
        'last_connectivity_state' => 'unknown',
    ];
}
