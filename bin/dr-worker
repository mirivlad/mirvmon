#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Backup\BackupContainer;
use App\Backup\BackupManifest;
use App\Backup\BackupOperationStore;
use App\Backup\BackupSecretCatalog;
use App\Backup\DisasterRecoveryRestorer;
use App\Backup\DrCutoverJournal;
use App\Backup\DrMaintenanceLock;
use App\Backup\FullBackupCreator;
use App\Backup\PostgresBackupTool;
use App\Backup\RestoreOperationStore;
use App\Database\ConnectionFactory;
use App\Security\SecretCipher;

require dirname(__DIR__) . '/vendor/autoload.php';

$interval = filter_var(
    getenv('DR_WORKER_INTERVAL') ?: 2,
    FILTER_VALIDATE_INT,
    ['options' => ['min_range' => 1, 'max_range' => 30]]
);
if ($interval === false) {
    fwrite(STDERR, "DR_WORKER_INTERVAL must be between 1 and 30 seconds.\n");
    exit(1);
}

$applicationKey = base64_decode((string) getenv('APP_KEY'), true);
if ($applicationKey === false || strlen($applicationKey) !== SODIUM_CRYPTO_SECRETBOX_KEYBYTES) {
    fwrite(STDERR, "APP_KEY must be a base64-encoded 32-byte key.\n");
    exit(1);
}

$database = databaseEnvironment();
$root = dirname(__DIR__) . '/var/dr';
$migrations = dirname(__DIR__) . '/migrations';
$journal = new DrCutoverJournal($root);
$restoreStore = new RestoreOperationStore($root . '/operations', restoreMaximumBytes());
$backupStore = new BackupOperationStore(
    $root . '/backup-operations',
    new SecretCipher($applicationKey)
);
$restorer = new DisasterRecoveryRestorer(
    $database,
    new PostgresBackupTool($database),
    new DrMaintenanceLock($root),
    $journal,
    $migrations,
    $applicationKey,
    dirname(__DIR__) . '/var/sessions'
);
$workerId = (gethostname() ?: 'mirvmon') . ':' . getmypid();
$runOnce = getenv('DR_WORKER_ONCE') === '1';
$running = true;
if (function_exists('pcntl_async_signals') && function_exists('pcntl_signal')) {
    pcntl_async_signals(true);
    pcntl_signal(SIGTERM, static function () use (&$running): void { $running = false; });
    pcntl_signal(SIGINT, static function () use (&$running): void { $running = false; });
}

$needsStartupRecovery = true;
do {
    try {
        if ($journal->read() !== null) {
            $recovered = $restorer->recoverInterruptedCutover();
            if ($recovered !== null) {
                if ($recovered['outcome'] === 'completed') {
                    $restoreStore->markSucceeded($recovered['operation_id'], $recovered['result']);
                    $restorer->acknowledgeCompletedCutover($recovered['operation_id']);
                } else {
                    $restoreStore->markFailed(
                        $recovered['operation_id'],
                        'interrupted_restore_rolled_back'
                    );
                }
            }
            $needsStartupRecovery = true;
        }

        if ($needsStartupRecovery) {
            $restoreStore->requeueInterrupted();
            $restoreStore->purgeExpired();
            $backupStore->requeueInterrupted();
            $backupStore->purgeExpired();
            $needsStartupRecovery = false;
        }

        // Disaster recovery always has priority over creating a new backup.
        $restore = $restoreStore->claimNext($workerId);
        if (is_array($restore)) {
            runRestore(
                $restore,
                $restorer,
                $restoreStore,
                $journal,
                $needsStartupRecovery
            );
            if ($runOnce) {
                $running = false;
            }
            continue;
        }

        $backup = $backupStore->claimNext($workerId);
        if (is_array($backup)) {
            runBackup(
                $backup,
                $backupStore,
                $database,
                $migrations,
                $applicationKey,
                $root
            );
            if ($runOnce) {
                $running = false;
            }
            continue;
        }

        if ($runOnce) {
            $running = false;
            continue;
        }
        sleepInterruptibly($interval, $running);
    } catch (Throwable $exception) {
        error_log('[mirvmon][dr-worker] ' . $exception->getMessage());
        $needsStartupRecovery = true;
        sleepInterruptibly($interval, $running);
    }
} while ($running);

/**
 * @param array<string,mixed> $operation
 */
function runRestore(
    array $operation,
    DisasterRecoveryRestorer $restorer,
    RestoreOperationStore $store,
    DrCutoverJournal $journal,
    bool &$needsStartupRecovery
): void {
    $id = $operation['id'] ?? null;
    $workspace = $operation['workspace'] ?? null;
    $manifest = $operation['manifest'] ?? null;
    if (!is_string($id) || !is_string($workspace) || !is_array($manifest)) {
        throw new RuntimeException('Claimed restore operation is incomplete.');
    }

    try {
        $result = $restorer->restore($id, $workspace, $manifest);
        $store->markSucceeded($id, $result);
        $restorer->acknowledgeCompletedCutover($id);
    } catch (Throwable $exception) {
        error_log('[mirvmon][dr-worker][restore] ' . $exception->getMessage());
        if ($journal->read() === null) {
            $store->markFailed($id, 'restore_failed');
        } else {
            // Preserve the workspace and running state. The next loop recovers the database
            // shape from the cutover journal before deciding whether to retry or complete.
            $needsStartupRecovery = true;
        }
    }
}

/**
 * @param array<string,mixed> $operation
 * @param array<string,string> $database
 */
function runBackup(
    array $operation,
    BackupOperationStore $store,
    array $database,
    string $migrations,
    string $applicationKey,
    string $root
): void {
    $id = $operation['id'] ?? null;
    if (!is_string($id)) {
        throw new RuntimeException('Claimed backup operation is incomplete.');
    }

    $password = '';
    try {
        $password = $store->passwordForClaim($operation);
        // Always build the object graph from a fresh connection. A prior restore may have
        // swapped the database underneath a long-lived worker process.
        $pdo = ConnectionFactory::connect($database);
        $creator = new FullBackupCreator(
            $pdo,
            new BackupSecretCatalog($pdo, new SecretCipher($applicationKey)),
            new BackupManifest($pdo, $migrations, applicationVersion()),
            new PostgresBackupTool($database),
            new BackupContainer(),
            $store->workspaceRoot($id)
        );
        $manifest = $creator->create($store->outputPath($id), $password);
        $store->markSucceeded($id, $manifest);
    } catch (Throwable $exception) {
        error_log('[mirvmon][dr-worker][backup] ' . $exception->getMessage());
        try {
            $store->markFailed($id, 'backup_failed');
        } catch (Throwable $stateException) {
            error_log('[mirvmon][dr-worker][backup-state] ' . $stateException->getMessage());
        }
    } finally {
        if ($password !== '') {
            sodium_memzero($password);
        }
    }
}

/** @return array<string,string> */
function databaseEnvironment(): array
{
    $result = [];
    foreach (['DB_HOST', 'DB_PORT', 'DB_NAME', 'DB_USERNAME', 'DB_PASSWORD', 'DB_SSLMODE'] as $name) {
        $value = getenv($name);
        if ($value !== false) {
            $result[$name] = $value;
        }
    }
    return $result;
}

function applicationVersion(): string
{
    $version = trim((string) (getenv('APP_VERSION') ?: 'development'));
    return $version === '' ? 'development' : $version;
}

function restoreMaximumBytes(): int
{
    $raw = getenv('BACKUP_MAX_UPLOAD_BYTES');
    if ($raw === false || $raw === '') {
        return 8589934592;
    }
    $value = filter_var($raw, FILTER_VALIDATE_INT, [
        'options' => ['min_range' => 1048576, 'max_range' => PHP_INT_MAX],
    ]);
    return $value === false ? 8589934592 : $value;
}

function sleepInterruptibly(int $seconds, bool &$running): void
{
    for ($second = 0; $second < $seconds && $running; $second++) {
        sleep(1);
    }
}
