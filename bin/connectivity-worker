#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Backup\DrMaintenanceLock;
use App\Database\ConnectionFactory;
use App\Repositories\AppSettingsRepository;
use App\Repositories\ConnectivityStateRepository;
use App\Repositories\NotificationOutboxRepository;
use App\Repositories\WorkerHeartbeatRepository;
use App\Services\ConnectivitySettingsService;
use App\Services\ConnectivityTransitionGuard;
use App\Services\ExternalConnectivityProbe;

require dirname(__DIR__) . '/vendor/autoload.php';

$once = in_array('--once', $argv, true);
$running = true;
if (function_exists('pcntl_async_signals') && function_exists('pcntl_signal')) {
    pcntl_async_signals(true);
    pcntl_signal(SIGTERM, static function () use (&$running): void { $running = false; });
    pcntl_signal(SIGINT, static function () use (&$running): void { $running = false; });
}

$runtime = null;
$lastState = null;
$lastConfig = null;
$transitionGuard = null;
$nextProbeAt = 0;
$maintenance = new DrMaintenanceLock(dirname(__DIR__) . '/var/dr');
do {
    $sleepSeconds = 5;
    $lease = $maintenance->acquireShared();
    if ($lease !== null) {
        try {
            $runtime ??= createConnectivityRuntime();
            $config = $runtime['config']->current();
            $now = new DateTimeImmutable();
            $nowTimestamp = $now->getTimestamp();
            $configChanged = $lastConfig !== null && $config !== $lastConfig;
            if ($transitionGuard === null || $configChanged) {
                $persistedState = $runtime['state']->current();
                $transitionGuard = new ConnectivityTransitionGuard($persistedState['state'] ?? null);
            }

            if ($nextProbeAt <= $nowTimestamp || $configChanged) {
                $probe = new ExternalConnectivityProbe(
                    $config['targets'],
                    $config['quorum'],
                    $config['timeout_seconds'],
                );
                $previousState = $runtime['state']->current();
                $startedAt = microtime(true);
                $result = $probe->probe();
                $elapsedMs = (int) round((microtime(true) - $startedAt) * 1000);
                $state = $transitionGuard->observe($result['available']);
                if ($result['failures'] > 0) {
                    fwrite(STDERR, 'connectivity_probe_failed_targets ' . json_encode([
                        'elapsed_ms' => $elapsedMs,
                        'available' => $result['available'],
                        'failed_targets' => $result['failed_targets'],
                        'failure_reasons' => $result['failure_reasons'],
                        'confirmed_state' => $transitionGuard->confirmedState(),
                    ], JSON_UNESCAPED_SLASHES) . PHP_EOL);
                }
                if (
                    $state === 'online'
                    && $previousState !== null
                    && $previousState['state'] === 'offline'
                ) {
                    $outageStartedAt = new DateTimeImmutable($previousState['changed_at']);
                    $durationSeconds = max(
                        0,
                        $now->getTimestamp() - $outageStartedAt->getTimestamp()
                    );
                    $runtime['outbox']->enqueueSystemConfigured(
                        'connectivity_recovered',
                        [
                            'type' => 'connectivity',
                            'event' => 'recovered',
                            'outage_started_at' => $outageStartedAt->format(DATE_ATOM),
                            'outage_ended_at' => $now->format(DATE_ATOM),
                            'duration_seconds' => $durationSeconds,
                            'event_time' => $now->format(DATE_ATOM),
                        ],
                        'connectivity_recovered:'
                            . hash('sha256', $outageStartedAt->format(DATE_ATOM))
                    );
                }
                if ($state !== null) {
                    // Only confirmed results may refresh the persisted connectivity state.
                    $runtime['state']->record($result, $now);
                    if ($state !== $lastState) {
                        fwrite(STDERR, 'connectivity_' . $state . PHP_EOL);
                        $lastState = $state;
                    }
                }
                $nextProbeAt = $nowTimestamp + $config['interval_seconds'];
                $lastConfig = $config;
            }

            $runtime['heartbeat']->record(WorkerHeartbeatRepository::CONNECTIVITY_WORKER);
            $sleepSeconds = max(1, min(5, $nextProbeAt - $nowTimestamp));
        } catch (PDOException) {
            fwrite(STDERR, "connectivity_worker_database_unavailable\n");
            $runtime = null;
            $transitionGuard = null;
            $lastConfig = null;
            $nextProbeAt = 0;
            if ($once) {
                $lease->release();
                exit(1);
            }
        } catch (Throwable $exception) {
            fwrite(STDERR, 'connectivity_worker_failed:' . $exception::class . PHP_EOL);
            $lease->release();
            exit(1);
        } finally {
            $lease->release();
        }
    }
    if ($once) {
        break;
    }
    for ($second = 0; $second < $sleepSeconds && $running; $second++) {
        sleep(1);
    }
} while ($running);

/** @return array{state: ConnectivityStateRepository, outbox: NotificationOutboxRepository, heartbeat: WorkerHeartbeatRepository, config: ConnectivitySettingsService} */
function createConnectivityRuntime(): array
{
    $pdo = ConnectionFactory::fromEnvironment();
    $settings = new AppSettingsRepository($pdo);
    return [
        'state' => new ConnectivityStateRepository($settings),
        'outbox' => new NotificationOutboxRepository($pdo),
        'heartbeat' => new WorkerHeartbeatRepository($pdo),
        'config' => new ConnectivitySettingsService($settings),
    ];
}
