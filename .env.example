# MirvMon production environment
#
# Copy this file to .env for Docker Compose. In Portainer, enter the same
# variables in the stack environment instead of committing an .env file.

# Application image. Pin a release tag for production, for example:
# MIRVMON_IMAGE=ghcr.io/mirivlad/mirvmon:1.0.0
MIRVMON_IMAGE=ghcr.io/mirivlad/mirvmon:latest

# Bind to loopback when nginx runs on the Docker host.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=UTC
APP_CPUS=2.0
APP_MEMORY_LIMIT=512m

# Optional canonical public URL. When empty, installer links use the trusted
# request host and scheme supplied by the reverse proxy.
PUBLIC_BASE_URL=
TRUSTED_PROXIES=private_ranges

# Required: generate with `openssl rand -base64 32`.
APP_KEY=

# PostgreSQL / TimescaleDB
DB_NAME=mirvmon
DB_USERNAME=mirvmon
# Required: generate with `openssl rand -hex 32`.
DB_PASSWORD=
DB_CPUS=2.0
DB_MEMORY_LIMIT=2g

# Optional startup tuning
DB_STARTUP_ATTEMPTS=60
