# MirvMon production environment
#
# Copy this file to .env for Docker Compose. In Portainer, enter the same
# variables in the stack environment instead of committing an .env file.

# Application image. Keep a release tag pinned: a new tag always forces a
# pull, so an upgrade cannot silently reuse the cached image. The mutable
# `latest` tag needs an explicit `docker compose pull` or the Portainer
# re-pull option, otherwise `up -d` keeps the image already on the host.
MIRVMON_IMAGE=ghcr.io/mirivlad/mirvmon:0.1.3

# Bind to loopback when nginx runs on the Docker host.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=UTC
APP_CPUS=2.0
APP_MEMORY_LIMIT=512m

# Optional canonical public URL. When empty, installer links use the trusted
# request host and scheme supplied by the reverse proxy.
PUBLIC_BASE_URL=
TRUSTED_PROXIES=private_ranges
# Keep enabled when users reach MirvMon through HTTPS. Set to 0 only for
# isolated direct-HTTP development.
SESSION_SECURE=1

# Required: generate with `openssl rand -base64 32`.
APP_KEY=
# Required only for creating the first administrator at /setup.
# Generate with `openssl rand -hex 32` and keep it outside version control.
SETUP_TOKEN=

# PostgreSQL / TimescaleDB
DB_NAME=mirvmon
DB_USERNAME=mirvmon
# Required: generate with `openssl rand -hex 32`.
DB_PASSWORD=
DB_CPUS=2.0
DB_MEMORY_LIMIT=2g

# Optional startup tuning
DB_STARTUP_ATTEMPTS=60
OFFLINE_CHECK_INTERVAL=15
NOTIFICATION_POLL_INTERVAL=2
NOTIFICATION_BATCH_SIZE=20
