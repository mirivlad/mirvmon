{% set platform = server.platform|default({
    family: 'unknown',
    icon_class: 'fas fa-server',
    tooltip: 'ОС не сообщена'
}) %}
{% set status_text = {
    online: 'в норме',
    warning: 'требует внимания',
    critical: 'критическое состояние',
    offline: 'нет актуальных данных'
}[server.status]|default('состояние неизвестно') %}
<span class="{{ icon_container_class|default('server-platform-icon') }} server-status-emblem"
      aria-label="{{ platform.tooltip }}, {{ status_text }}"
      title="{{ platform.tooltip }}" data-bs-toggle="tooltip">
    <i{% if icon_id|default('') %} id="{{ icon_id }}"{% endif %}
       class="{{ platform.icon_class }}" aria-hidden="true"></i>
</span>
