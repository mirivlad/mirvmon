{% if agent_update %}
{% set state_labels = {
    current: [t('agent.state.current'), 'success', 'fa-circle-check'],
    unknown: [t('agent.state.unknown'), 'secondary', 'fa-circle-question'],
    manual_required: [t('agent.state.manual_required'), 'warning', 'fa-triangle-exclamation'],
    update_available: [t('agent.state.update_available'), 'info', 'fa-circle-arrow-up'],
    pending: [t('agent.state.pending'), 'secondary', 'fa-clock'],
    accepted: [t('agent.state.accepted'), 'info', 'fa-circle-check'],
    downloading: [t('agent.state.downloading'), 'info', 'fa-download'],
    installing: [t('agent.state.installing'), 'warning', 'fa-gears'],
    awaiting_restart: [t('agent.state.awaiting_restart'), 'warning', 'fa-rotate'],
    succeeded: [t('agent.state.succeeded'), 'success', 'fa-circle-check'],
    failed: [t('agent.state.failed'), 'danger', 'fa-circle-xmark']
} %}
{% set state = state_labels[agent_update.state]|default(state_labels.unknown) %}
{% set error_labels = {
    checksum_mismatch: t('agent.error.checksum_mismatch'),
    identity_mismatch: t('agent.error.identity_mismatch'),
    download_failed: t('agent.error.download_failed'),
    handoff_failed: t('agent.error.handoff_failed'),
    apply_failed: t('agent.error.apply_failed'),
    target_superseded: t('agent.error.target_superseded'),
    update_failed: t('agent.error.update_failed')
} %}
<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h4 class="mb-3"><i class="fas fa-code-branch"></i> {{ t('agent.version.title') }}</h4>
                <dl class="row mb-0">
                    <dt class="col-sm-5">{{ t('agent.version.installed') }}</dt>
                    <dd class="col-sm-7"><code>{{ agent_update.installed_version|default(t('agent.version.not_reported')) }}</code></dd>
                    <dt class="col-sm-5">{{ t('agent.version.available') }}</dt>
                    <dd class="col-sm-7"><code>{{ agent_update.available_version }}</code></dd>
                </dl>
            </div>
            <div class="text-sm-end">
                <span class="badge text-bg-{{ state[1] }} mb-2">
                    <i class="fas {{ state[2] }} me-1" aria-hidden="true"></i>{{ state[0] }}
                </span>
                {% if agent_update.command and agent_update.command.error_code %}
                    <div class="small text-danger">{{ error_labels[agent_update.command.error_code]|default(t('agent.error.update_failed')) }}</div>
                {% endif %}
            </div>
        </div>
        {% if session.role == 'admin' and agent_update.can_update and agent_update.state in ['update_available', 'failed'] %}
            <form method="post" action="/servers/{{ server.id }}/agent/update" class="mt-3">
                {% include "partials/csrf.twig" %}
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-circle-arrow-up me-1"></i>
                    {{ agent_update.state == 'failed' ? t('agent.retry_update') : t('agent.update') }}
                </button>
            </form>
        {% endif %}
        {% if agent_update.state == 'manual_required' %}
            <p class="small text-muted mb-0 mt-2">{{ t('agent.manual_help') }}</p>
        {% endif %}
    </div>
</div>
{% endif %}

<div class="card">
    <div class="card-body">
        <h4><i class="fas fa-download"></i> {{ t('agent.management.title') }}</h4>
        <p class="text-muted">{{ t('agent.management.help') }}</p>
        {% if requires_token_rotation %}
            <div class="alert alert-warning small">{{ t('agent.management.legacy_token') }}</div>
        {% else %}
            <form method="post" action="/servers/{{ server.id }}/installers" class="d-inline">
                {% include "partials/csrf.twig" %}
                <button type="submit" class="btn btn-outline-primary"><i class="fas fa-download"></i> {{ t('agent.management.download_installers') }}</button>
            </form>
        {% endif %}
        <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#revokeAgentTokenModal">
            <i class="fas fa-sync-alt"></i>
            {{ has_agent_token ? t('agent.management.revoke_key') : t('agent.management.create_key') }}
        </button>
    </div>
</div>

<div class="modal fade" id="revokeAgentTokenModal" tabindex="-1" aria-labelledby="revokeAgentTokenTitle" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <form method="post" action="/servers/{{ server.id }}/regenerate-token">
            {% include "partials/csrf.twig" %}
            <div class="modal-header">
                <h5 class="modal-title" id="revokeAgentTokenTitle">{{ t('agent.management.revoke_title') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('common.close') }}"></button>
            </div>
            <div class="modal-body">{{ t('agent.management.revoke_body') }}</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ t('common.cancel') }}</button>
                <button type="submit" class="btn btn-warning">{{ t('agent.management.revoke_submit') }}</button>
            </div>
        </form>
    </div></div>
</div>
