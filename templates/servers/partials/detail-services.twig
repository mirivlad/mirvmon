<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1"><i class="fas fa-gears me-1" aria-hidden="true"></i>{{ t('server18.services.title') }}</h2>
        <p class="text-muted mb-0">{{ t('server18.services.help') }}</p>
    </div>
    <a href="/servers/{{ server.id }}/edit#services-monitoring" class="btn btn-outline-primary">
        <i class="fas fa-list-check me-1" aria-hidden="true"></i>{{ t('server18.services.configure') }}
    </a>
</div>

{% if allServices is empty %}
<div class="alert alert-info"><i class="fas fa-circle-info me-1" aria-hidden="true"></i>{{ t('server.services.no_list') }}</div>
{% else %}
    {% set runningServices = allServices|filter(s => s.status == 'running') %}
    {% set stoppedServices = allServices|filter(s => s.status == 'stopped') %}
    {% set unknownServices = allServices|filter(s => s.status != 'running' and s.status != 'stopped') %}

    <div class="row g-3 mb-3">
        {% for key, collection in {running: runningServices, stopped: stoppedServices, unknown: unknownServices} %}
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-muted">{{ t('server18.services.' ~ key) }}</div>
                        <div class="h4 mb-0">{{ collection|length }}</div>
                    </div>
                    <i class="fas {{ key == 'running' ? 'fa-circle-check text-success' : (key == 'stopped' ? 'fa-circle-xmark text-danger' : 'fa-circle-question text-warning') }} fa-2x" aria-hidden="true"></i>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr>
                        <th>{{ t('server18.services.name') }}</th>
                        <th>{{ t('server18.services.state') }}</th>
                        <th>{{ t('server18.services.monitoring') }}</th>
                        <th>{{ t('server18.services.details') }}</th>
                        <th>{{ t('server18.services.updated') }}</th>
                    </tr></thead>
                    <tbody>
                    {% for service in allServices %}
                        <tr>
                            <td><code>{{ service.service_name }}</code></td>
                            <td>
                                {% if service.status == 'running' %}
                                    <span class="badge text-bg-success">{{ t('server.services.running') }}</span>
                                {% elseif service.status == 'stopped' %}
                                    <span class="badge text-bg-danger">{{ t('server.services.stopped') }}</span>
                                {% else %}
                                    <span class="badge text-bg-warning">{{ t('server.services.unknown') }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if service.service_name in monitorServices %}
                                    <span class="badge text-bg-primary"><i class="fas fa-eye me-1" aria-hidden="true"></i>{{ t('server18.services.monitored') }}</span>
                                {% else %}
                                    <span class="text-muted">{{ t('server18.services.not_monitored') }}</span>
                                {% endif %}
                            </td>
                            <td class="small text-muted">
                                {{ t('server.services.load') }}: {{ service.load_state|default('—') }}<br>
                                {{ t('server.services.active') }}: {{ service.active_state|default('—') }}{% if service.sub_state %} · {{ service.sub_state }}{% endif %}
                            </td>
                            <td class="small text-nowrap">{% if service.updated_at %}{{ service.updated_at|date('d.m.Y H:i:s') }}{% else %}—{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endif %}
