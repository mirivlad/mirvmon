{% extends "layout.twig" %}
{% set page_title = t('server.page_title', {name: server.name}) %}

{% block content %}
<div class="card mb-3" data-live-fragment="server-header" data-live-url="/servers/{{ server.id }}?tab=agent" data-live-interval-ms="15000">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1 server-status-{{ server.status }}">
                {% include "partials/server-status-icon.twig" %}
                {{ server.name }}
                {% if server.group_name %}
                    <span class="badge ms-2" {% if server.group_color %}style="background-color: {{ server.group_color }}"{% endif %}>
                        <i class="fas {{ server.group_icon|default('fa-box') }} me-1" aria-hidden="true"></i>{{ server.group_name }}
                    </span>
                {% endif %}
            </h1>
            {% if server.description %}<div class="text-muted">{{ server.description }}</div>{% endif %}
        </div>
        <div class="d-flex flex-wrap gap-2">
            {% if not maintenance %}
            <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#maintenanceModal">
                <i class="fas fa-screwdriver-wrench me-1" aria-hidden="true"></i>{{ t('server18.maintenance.start') }}
            </button>
            {% endif %}
            <a href="/servers/{{ server.id }}/edit" class="btn btn-outline-primary">
                <i class="fas fa-sliders me-1" aria-hidden="true"></i>{{ t('server18.settings.open') }}
            </a>
            <a href="/servers" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>{{ t('server.back_to_list') }}
            </a>
        </div>
    </div>
</div>

<div data-live-fragment="server-maintenance" data-live-url="/servers/{{ server.id }}?tab=agent" data-live-interval-ms="15000">
{% if maintenance %}
<div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <i class="fas fa-screwdriver-wrench me-1" aria-hidden="true"></i>
        <strong>{{ t('server.maintenance.until', {time: maintenance.ends_at|date('d.m.Y H:i')}) }}</strong>
        {{ t('server.maintenance.suppressed') }}
        {% if maintenance.reason %}<span class="ms-1">{{ t('server.maintenance.reason', {reason: maintenance.reason}) }}</span>{% endif %}
        {% if maintenance.created_by %}<span class="text-muted small ms-1">{{ t('server.maintenance.created_by', {user: maintenance.created_by}) }}</span>{% endif %}
    </div>
    <form method="post" action="/servers/{{ server.id }}/maintenance/cancel" class="mb-0">
        {% include "partials/csrf.twig" %}
        <button type="submit" class="btn btn-sm btn-warning">
            <i class="fas fa-play me-1" aria-hidden="true"></i>{{ t('server.maintenance.end') }}
        </button>
    </form>
</div>
{% endif %}
</div>

<ul class="nav nav-tabs mb-3" aria-label="{{ t('server18.tabs.label') }}">
    {% set tabs = {
        overview: ['fa-gauge-high', t('server18.tabs.overview')],
        metrics: ['fa-chart-line', t('server18.tabs.metrics')],
        services: ['fa-gears', t('server18.tabs.services')],
        events: ['fa-clock-rotate-left', t('server18.tabs.events')],
        agent: ['fa-code-branch', t('server18.tabs.agent')]
    } %}
    {% for tab, meta in tabs %}
    <li class="nav-item">
        <a href="/servers/{{ server.id }}?tab={{ tab }}" class="nav-link {{ active_tab == tab ? 'active fw-semibold' : '' }}" {% if active_tab == tab %}aria-current="page"{% endif %}>
            <i class="fas {{ meta[0] }} me-1" aria-hidden="true"></i>{{ meta[1] }}
            {% if tab == 'events' %}<span class="badge text-bg-danger ms-1{{ active_problem_count > 0 ? '' : ' d-none' }}" data-live-fragment="server-problem-count" data-live-url="/servers/{{ server.id }}?tab=agent" data-live-interval-ms="15000">{{ active_problem_count }}</span>{% endif %}
        </a>
    </li>
    {% endfor %}
</ul>

{% if active_tab == 'overview' %}
    <div data-live-fragment="server-overview" data-live-interval-ms="30000">{% include "servers/partials/detail-overview.twig" %}</div>
{% elseif active_tab == 'metrics' %}
    {% include "servers/partials/detail-metrics.twig" %}
{% elseif active_tab == 'services' %}
    {% include "servers/partials/detail-services.twig" %}
{% elseif active_tab == 'events' %}
    <div data-live-fragment="server-events" data-live-interval-ms="10000">{% include "servers/partials/detail-events.twig" %}</div>
{% elseif active_tab == 'agent' %}
    <div data-live-fragment="server-agent" data-live-interval-ms="5000">{% include "servers/partials/agent-management.twig" %}</div>
{% endif %}

<div class="modal fade" id="maintenanceModal" tabindex="-1" aria-labelledby="maintenanceModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/servers/{{ server.id }}/maintenance">
                {% include "partials/csrf.twig" %}
                <div class="modal-header">
                    <h5 class="modal-title" id="maintenanceModalTitle"><i class="fas fa-screwdriver-wrench me-1" aria-hidden="true"></i>{{ t('server18.maintenance.title') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('common.close') }}"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="duration_minutes" class="form-label">{{ t('server.maintenance.pause_notifications') }}</label>
                        <select class="form-select" id="duration_minutes" name="duration_minutes">
                            <option value="30">30 {{ t('common.minutes') }}</option>
                            <option value="60" selected>{{ t('server.period.hour_1') }}</option>
                            <option value="240">4 {{ t('common.hours') }}</option>
                            <option value="720">12 {{ t('common.hours') }}</option>
                            <option value="1440">24 {{ t('common.hours') }}</option>
                        </select>
                    </div>
                    <div>
                        <label for="maintenance_reason" class="form-label">{{ t('server18.maintenance.reason') }}</label>
                        <input type="text" class="form-control" id="maintenance_reason" name="reason" maxlength="255" placeholder="{{ t('server.maintenance.reason_placeholder') }}">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ t('common.cancel') }}</button>
                    <button type="submit" class="btn btn-warning"><i class="fas fa-screwdriver-wrench me-1" aria-hidden="true"></i>{{ t('server18.maintenance.start') }}</button>
                </div>
            </form>
        </div>
    </div>
</div>

{% if active_tab == 'metrics' %}
    {% include "servers/partials/detail-scripts.twig" %}
{% endif %}
{% endblock %}
