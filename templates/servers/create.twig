{% extends "layout.twig" %}
{% set page_title = t('servers.create.title') %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-plus-circle"></i> {{ t('servers.create.title') }}</h3>
            </div>
            <div class="card-body">
                <form method="post" action="/servers">
                    {% include "partials/csrf.twig" %}
                    <div class="mb-3">
                        <label for="name" class="form-label">{{ t('servers.form.name') }}</label>
                        <input type="text" class="form-control" id="name" name="name" required>
                        <small class="form-text text-muted">{{ t('servers.form.name_help') }}</small>
                    </div>
                    <div class="mb-3">
                        <label for="address" class="form-label">{{ t('servers.form.address') }}</label>
                        <input type="text" class="form-control" id="address" name="address" placeholder="IP / DNS">
                        <small class="form-text text-muted">{{ t('servers.form.address_help') }}</small>
                    </div>
                    <div class="mb-3">
                        <label for="group_id" class="form-label">{{ t('servers.form.group') }}</label>
                        <select class="form-select" id="group_id" name="group_id">
                            <option value="">{{ t('servers.form.group_none') }}</option>
                            {% for group in groups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}
                        </select>
                        <small class="form-text text-muted">{{ t('servers.form.group_help') }}</small>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">{{ t('servers.form.description') }}</label>
                        <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                        <small class="form-text text-muted">{{ t('servers.form.description_help') }}</small>
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="/servers" class="btn btn-secondary me-md-2"><i class="fas fa-arrow-left"></i> {{ t('common.back') }}</a>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> {{ t('common.save') }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
