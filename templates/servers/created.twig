{% extends "layout.twig" %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-check-circle text-success"></i> Сервер добавлен</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading">Сервер "{{ server.name }}" успешно добавлен!</h4>
                    <p>Скачайте один подходящий установщик. Каждая ссылка
                       одноразовая и действует один час.</p>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <a href="/agent/install.sh?token={{ installer_tokens.linux|url_encode }}" class="btn btn-primary">
                            <i class="fab fa-linux"></i> Агент для Linux
                        </a>
                        <a href="/agent/install.exe?token={{ installer_tokens.windows|url_encode }}" class="btn btn-info">
                            <i class="fab fa-windows"></i> Агент для Windows x64
                        </a>
                    </div>
                </div>
                
                <div class="mt-4">
                    <h5>Инструкция по установке:</h5>
                    
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="fab fa-linux"></i> Linux
                        </div>
                        <div class="card-body">
                            <ol class="mb-0">
                                <li>Скачайте скрипт <code>install.sh</code></li>
                                <li>Загрузите на сервер</li>
                                <li>Выполните: <code>chmod +x install.sh && ./install.sh</code></li>
                            </ol>
                        </div>
                    </div>
                    
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="fab fa-windows"></i> Windows x64
                        </div>
                        <div class="card-body">
                            <ol class="mb-0">
                                <li>Скачайте <code>MirvMon-Agent-Setup.exe</code></li>
                                <li>Запустите файл <strong>от имени Администратора</strong></li>
                                <li>Подтвердите запуск неподписанного установщика</li>
                            </ol>
                        </div>
                    </div>

                    <p class="text-muted small">
                        Поддерживаются Windows 7 SP1, 8, 8.1, 10, 11 и Windows
                        Server 2008 R2 SP1, 2012, 2012 R2, 2016, 2019, 2022,
                        2025 — только x64. Установщик сам выберет совместимую
                        сборку агента, перенесёт конфигурацию и очередь.
                    </p>
                </div>
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a href="/servers" class="btn btn-primary me-md-2">
                        <i class="fas fa-server"></i> К списку серверов
                    </a>
                    <a href="/servers/{{ server.id }}" class="btn btn-outline-primary">
                        <i class="fas fa-server"></i> Открыть сервер
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
