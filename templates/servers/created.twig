{% extends "layout.twig" %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-check-circle text-success"></i> Сервер добавлен</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading">Сервер "{{ server.name }}" успешно добавлен!</h4>
                    <p>Скачайте один подходящий установщик. Каждая ссылка
                       одноразовая и действует один час.</p>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <a href="/agent/install.sh?token={{ installer_tokens.linux|url_encode }}" class="btn btn-primary">
                            <i class="fab fa-linux"></i> Агент для Linux
                        </a>
                        <a href="/agent/install.ps1?token={{ installer_tokens.powershell|url_encode }}" class="btn btn-info">
                            <i class="fab fa-windows"></i> PowerShell
                        </a>
                        <a href="/agent/install.bat?token={{ installer_tokens.batch|url_encode }}" class="btn btn-outline-info">
                            <i class="fab fa-windows"></i> BAT
                        </a>
                        <a href="/agent/install-legacy.bat?token={{ installer_tokens.legacy_batch|url_encode }}" class="btn btn-warning">
                            <i class="fab fa-windows"></i> Windows 7 / 2008 (BAT)
                        </a>
                        <a href="/agent/install-legacy.ps1?token={{ installer_tokens.legacy_powershell|url_encode }}" class="btn btn-outline-warning">
                            <i class="fab fa-windows"></i> Windows 7 / 2008 (PS1)
                        </a>
                    </div>
                </div>
                
                <div class="mt-4">
                    <h5>Инструкция по установке:</h5>
                    
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="fab fa-linux"></i> Linux
                        </div>
                        <div class="card-body">
                            <ol class="mb-0">
                                <li>Скачайте скрипт <code>install.sh</code></li>
                                <li>Загрузите на сервер</li>
                                <li>Выполните: <code>chmod +x install.sh && ./install.sh</code></li>
                            </ol>
                        </div>
                    </div>
                    
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="fab fa-windows"></i> Windows Server 2012+
                        </div>
                        <div class="card-body">
                            <ol class="mb-0">
                                <li>Скачайте скрипт <code>install.ps1</code></li>
                                <li>Запустите PowerShell <strong>от имени Администратора</strong></li>
                                <li>Выполните: <code>Set-ExecutionPolicy Bypass -Scope Process -Force; .\install.ps1</code></li>
                            </ol>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <i class="fab fa-windows"></i> Windows 7 SP1 / Server 2008 R2
                        </div>
                        <div class="card-body">
                            <p class="mb-2">
                                Python на этих системах не ставится: CPython 3.9
                                и новее их не поддерживает. Установщик для них
                                разворачивает отдельный сборщик на PowerShell 2.0,
                                который собирает метрики через WMI и не требует
                                ничего дополнительно.
                            </p>
                            <ol class="mb-2">
                                <li>Скачайте <code>mirvmon-install-legacy.bat</code></li>
                                <li>Запустите <strong>от имени Администратора</strong></li>
                            </ol>
                            <p class="mb-0 text-muted small">
                                Задача планировщика «MirvMon Agent» отправляет
                                замер раз в минуту. Собираются CPU, память,
                                диски, сеть, аптайм и службы; снимок процессов
                                и удалённая настройка агента в этом режиме
                                недоступны.
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a href="/servers" class="btn btn-primary me-md-2">
                        <i class="fas fa-server"></i> К списку серверов
                    </a>
                    <a href="/servers/{{ server.id }}/edit" class="btn btn-outline-primary">
                        <i class="fas fa-edit"></i> Редактировать сервер
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
