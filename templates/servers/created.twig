{% extends "layout.twig" %}
{% set page_title = t('servers.created.title') %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-check-circle text-success"></i> {{ t('servers.created.title') }}</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading">{{ t('servers.created.success', {name: server.name}) }}</h4>
                    <p>{{ t('servers.created.download_hint') }}</p>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <a href="/agent/install.sh?token={{ installer_tokens.linux|url_encode }}" class="btn btn-primary">
                            <i class="fab fa-linux"></i> {{ t('servers.created.linux_agent') }}
                        </a>
                        <a href="/agent/install.exe?token={{ installer_tokens.windows|url_encode }}" class="btn btn-info">
                            <i class="fab fa-windows"></i> {{ t('servers.created.windows_agent') }}
                        </a>
                    </div>
                </div>

                <div class="mt-4">
                    <h5>{{ t('servers.created.installation') }}:</h5>
                    <div class="card mb-3">
                        <div class="card-header"><i class="fab fa-linux"></i> Linux</div>
                        <div class="card-body">
                            <ol class="mb-0">
                                <li>{{ t('servers.created.linux.step1') }}</li>
                                <li>{{ t('servers.created.linux.step2') }}</li>
                                <li>{{ t('servers.created.linux.step3') }}: <code>chmod +x install.sh && sudo ./install.sh</code></li>
                            </ol>
                        </div>
                    </div>
                    <div class="card mb-3">
                        <div class="card-header"><i class="fab fa-windows"></i> Windows x64</div>
                        <div class="card-body">
                            <ol class="mb-0">
                                <li>{{ t('servers.created.windows.step1') }}</li>
                                <li>{{ t('servers.created.windows.step2') }}</li>
                                <li>{{ t('servers.created.windows.step3') }}</li>
                            </ol>
                        </div>
                    </div>
                    <p class="text-muted small">{{ t('servers.created.windows.support') }}</p>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a href="/servers" class="btn btn-primary me-md-2"><i class="fas fa-server"></i> {{ t('servers.created.to_list') }}</a>
                    <a href="/servers/{{ server.id }}" class="btn btn-outline-primary"><i class="fas fa-server"></i> {{ t('servers.created.open') }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
