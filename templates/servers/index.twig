{% extends "layout.twig" %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2><i class="fas fa-server"></i> Серверы</h2>
            <a href="/servers/create" class="btn btn-primary">
                <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">Добавить сервер</span>
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                {% if servers|length > 0 %}
                <div class="table-responsive">
                    <form id="server-filters" method="get" action="/servers" data-server-filter-form>
                        <input type="hidden" name="sort" value="{{ sort }}">
                        <input type="hidden" name="direction" value="{{ direction|lower }}">
                    </form>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th><a href="{{ sort_urls.name }}" class="link-dark text-decoration-none">Название{% if sort == 'name' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th><a href="{{ sort_urls.address }}" class="link-dark text-decoration-none">Адрес{% if sort == 'address' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th><a href="{{ sort_urls.group }}" class="link-dark text-decoration-none">Группа{% if sort == 'group' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th><a href="{{ sort_urls.description }}" class="link-dark text-decoration-none">Описание{% if sort == 'description' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th><a href="{{ sort_urls.last_metrics }}" class="link-dark text-decoration-none">Последние метрики{% if sort == 'last_metrics' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th>Агент</th>
                                <th>Действия</th>
                            </tr>
                            <tr>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="name" value="{{ filters.name }}" aria-label="Поиск по названию" placeholder="Поиск"></th>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="address" value="{{ filters.address }}" aria-label="Поиск по адресу" placeholder="Поиск"></th>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="group" value="{{ filters.group }}" aria-label="Поиск по группе" placeholder="Поиск"></th>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="description" value="{{ filters.description }}" aria-label="Поиск по описанию" placeholder="Поиск"></th>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="last_metrics" value="{{ filters.last_metrics }}" aria-label="Поиск по последним метрикам" placeholder="Поиск"></th>
                                <th></th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for server in servers %}
                            <tr>
                                <td>
                                    {% set os = server.os_version|default('') %}
                                    {% if os|lower starts with 'windows' %}
                                        {% set os_icon = 'fab fa-windows' %}
                                    {% elseif os|lower starts with 'linux' %}
                                        {% set os_icon = 'fab fa-linux' %}
                                    {% else %}
                                        {% set os_icon = 'fas fa-server' %}
                                    {% endif %}
                                    <i class="{{ os_icon }} me-1" aria-label="{{ os ?: 'ОС не сообщена' }}" data-bs-toggle="tooltip" title="{{ os ?: 'ОС не сообщена' }}"></i>{{ server.name }}
                                </td>
                                <td>{{ server.address|default('-') }}</td>
                                <td>
                                    {% if server.group_name %}
                                        <i class="fas {{ server.group_icon|default('fa-box') }}" {% if server.group_color %}style="color: {{ server.group_color }}"{% endif %}></i> {{ server.group_name }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>{{ server.description|default('-')|slice(0, 30) ~ (attribute(server, 'description')|length > 30 ? '...' : '') }}</td>
                                <td>
                                    {% if server.last_metrics_at %}
                                        {{ server.last_metrics_at|date('d.m.Y H:i:s') }}
                                    {% else %}
                                        Нет данных
                                    {% endif %}
                                </td>
                                <td>
                                    {% if server.agent_version %}
                                        <span class="badge bg-light text-dark">{{ server.agent_version }}</span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="/servers/{{ server.id }}" class="btn btn-sm btn-info" title="Просмотр">
                                        <i class="fas fa-eye"></i> <span class="d-none d-sm-inline">Просмотр</span>
                                    </a>
                                    <a href="/servers/{{ server.id }}/edit" class="btn btn-sm btn-outline-primary" title="Редактировать">
                                        <i class="fas fa-edit"></i> <span class="d-none d-sm-inline">Редактировать</span>
                                    </a>
                                    <form method="post" action="/servers/{{ server.id }}/delete" class="d-inline">
                                        {% include "partials/csrf.twig" %}
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                title="Удалить"
                                                data-confirm="Вы уверены, что хотите удалить этот сервер?">
                                            <i class="fas fa-trash"></i> <span class="d-none d-sm-inline">Удалить</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-server fa-3x text-muted mb-3"></i>
                    <p class="lead">Серверы пока не добавлены</p>
                    <a href="/servers/create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Добавить первый сервер
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
