{% extends "layout.twig" %}
{% set page_title = t('servers.title') %}

{% block content %}
{% set update_indicators = {
    current: ['fa-circle-check', 'text-success', t('agent.state.current')],
    unknown: ['fa-circle-question', 'text-secondary', t('agent.state.unknown')],
    manual_required: ['fa-triangle-exclamation', 'text-warning', t('agent.state.manual_required')],
    update_available: ['fa-circle-arrow-up', 'text-info', t('agent.state.update_available')],
    pending: ['fa-clock', 'text-secondary', t('agent.state.pending')],
    accepted: ['fa-circle-check', 'text-info', t('agent.state.accepted')],
    downloading: ['fa-download', 'text-info', t('agent.state.downloading')],
    installing: ['fa-gears', 'text-warning', t('agent.state.installing')],
    awaiting_restart: ['fa-rotate', 'text-warning', t('agent.state.awaiting_restart')],
    failed: ['fa-circle-xmark', 'text-danger', t('agent.state.failed')]
} %}
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2><i class="fas fa-server"></i> {{ t('servers.title') }}</h2>
            <a href="/servers/create" class="btn btn-primary">
                <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">{{ t('servers.add') }}</span>
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                {% if servers|length > 0 %}
                <div class="table-responsive">
                    <form id="server-filters" method="get" action="/servers" data-server-filter-form>
                        <input type="hidden" name="sort" value="{{ sort }}">
                        <input type="hidden" name="direction" value="{{ direction|lower }}">
                        <input type="hidden" name="agent" value="" data-agent-filter-value>
                    </form>
                    {% if session.role == 'admin' %}
                    <form id="agent-update-csrf" class="d-none" aria-hidden="true">
                        {% include "partials/csrf.twig" %}
                    </form>
                    {% endif %}
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th><a href="{{ sort_urls.name }}" data-server-sort-link class="link-dark text-decoration-none">{{ t('servers.column.name') }}{% if sort == 'name' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th><a href="{{ sort_urls.address }}" data-server-sort-link class="link-dark text-decoration-none">{{ t('servers.column.address') }}{% if sort == 'address' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th><a href="{{ sort_urls.group }}" data-server-sort-link class="link-dark text-decoration-none">{{ t('servers.column.group') }}{% if sort == 'group' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th><a href="{{ sort_urls.description }}" data-server-sort-link class="link-dark text-decoration-none">{{ t('servers.column.description') }}{% if sort == 'description' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th><a href="{{ sort_urls.last_metrics }}" data-server-sort-link class="link-dark text-decoration-none">{{ t('servers.column.last_metrics') }}{% if sort == 'last_metrics' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}</a></th>
                                <th>{{ t('servers.column.agent') }}</th>
                                <th>{{ t('common.actions') }}</th>
                            </tr>
                            <tr>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="name" value="{{ filters.name }}" aria-label="{{ t('servers.column.name') }}" placeholder="{{ t('common.search') }}"></th>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="address" value="{{ filters.address }}" aria-label="{{ t('servers.column.address') }}" placeholder="{{ t('common.search') }}"></th>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="group" value="{{ filters.group }}" aria-label="{{ t('servers.column.group') }}" placeholder="{{ t('common.search') }}"></th>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="description" value="{{ filters.description }}" aria-label="{{ t('servers.column.description') }}" placeholder="{{ t('common.search') }}"></th>
                                <th><input form="server-filters" class="form-control form-control-sm" type="search" name="last_metrics" value="{{ filters.last_metrics }}" aria-label="{{ t('servers.column.last_metrics') }}" placeholder="{{ t('common.search') }}"></th>
                                <th>
                                    <select class="form-select form-select-sm" aria-label="{{ t('servers.filter.agent.label') }}" data-agent-filter>
                                        <option value="all">{{ t('servers.filter.agent.all') }}</option>
                                        <option value="current">{{ t('servers.filter.agent.current') }}</option>
                                        <option value="outdated">{{ t('servers.filter.agent.outdated') }}</option>
                                    </select>
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for server in servers %}
                            {% set agent_known = server.agent_update and server.agent_update.installed_version %}
                            {% set agent_outdated = server.agent_update and server.agent_update.is_outdated is same as(true) %}
                            {% set agent_filter_state = agent_outdated ? '1' : (agent_known ? '0' : 'unknown') %}
                            {% set indicator = server.agent_update ? update_indicators[server.agent_update.state]|default(update_indicators.unknown) : null %}
                            <tr data-agent-row
                                data-server-id="{{ server.id }}"
                                data-agent-outdated="{{ agent_filter_state }}"
                                data-agent-state="{{ server.agent_update.state|default('unknown') }}">
                                <td class="server-status-{{ server.status }}">
                                    {% include "partials/server-status-icon.twig" %}
                                    {{ server.name }}
                                </td>
                                <td>{{ server.address|default('-') }}</td>
                                <td>
                                    {% if server.group_name %}
                                        <i class="fas {{ server.group_icon|default('fa-box') }}" {% if server.group_color %}style="color: {{ server.group_color }}"{% endif %}></i> {{ server.group_name }}
                                    {% else %}-{% endif %}
                                </td>
                                <td>{{ server.description|default('-')|slice(0, 30) ~ (attribute(server, 'description')|length > 30 ? '...' : '') }}</td>
                                <td>{% if server.last_metrics_at %}{{ server.last_metrics_at|date('d.m.Y H:i:s') }}{% else %}{{ t('common.no_data') }}{% endif %}</td>
                                <td>
                                    <a href="/servers/{{ server.id }}?tab=agent" class="text-decoration-none">
                                        <span class="badge bg-light text-dark" data-agent-version>{{ server.agent_version|default('—') }}</span>
                                    </a>
                                    {% if server.agent_update and indicator %}
                                        <span class="ms-1" data-agent-state-control>
                                            {% if session.role == 'admin' and server.agent_update.can_update and server.agent_update.state in ['update_available', 'failed'] %}
                                                <button type="button"
                                                        class="btn btn-link btn-sm p-0 align-baseline {{ indicator[1] }}"
                                                        data-agent-update-button
                                                        data-update-url="/servers/{{ server.id }}/agent/update"
                                                        title="{{ server.agent_update.state == 'failed' ? t('agent.retry_update') : t('agent.update_to', {version: server.agent_update.available_version}) }}"
                                                        aria-label="{{ server.agent_update.state == 'failed' ? t('agent.retry_update') : t('agent.update') }}">
                                                    <i class="fas {{ indicator[0] }}" aria-hidden="true"></i>
                                                </button>
                                            {% else %}
                                                <i class="fas {{ indicator[0] }} {{ indicator[1] }}" aria-label="{{ indicator[2] }}" title="{{ indicator[2] }}"></i>
                                            {% endif %}
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% include "partials/action-button.twig" with {href: '/servers/' ~ server.id, icon: 'fa-eye', label: t('common.view'), class: 'btn-info'} %}
                                    {% include "partials/action-button.twig" with {href: '/servers/' ~ server.id ~ '/edit', icon: 'fa-edit', label: t('common.edit'), class: 'btn-outline-primary'} %}
                                    {% include "partials/action-button.twig" with {form_action: '/servers/' ~ server.id ~ '/delete', icon: 'fa-trash', label: t('common.delete'), class: 'btn-outline-danger', confirm: t('servers.delete.confirm')} %}
                                </td>
                            </tr>
                            {% endfor %}
                            <tr data-agent-filter-empty hidden>
                                <td colspan="7" class="text-center text-muted py-4">{{ t('servers.filter.empty') }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-server fa-3x text-muted mb-3"></i>
                    <p class="lead">{{ t('servers.empty.heading') }}</p>
                    <a href="/servers/create" class="btn btn-primary"><i class="fas fa-plus"></i> {{ t('servers.empty.add') }}</a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% if servers|length > 0 %}
<script nonce="__MIRVMON_CSP_NONCE__">
(() => {
    'use strict';

    const canManageAgents = {{ session.role == 'admin' ? 'true' : 'false' }};
    const activeStates = new Set(['pending', 'accepted', 'downloading', 'installing', 'awaiting_restart']);
    const stateMeta = {
        current: { icon: 'fa-circle-check', className: 'text-success', label: {{ t('agent.state.current')|json_encode|raw }} },
        unknown: { icon: 'fa-circle-question', className: 'text-secondary', label: {{ t('agent.state.unknown')|json_encode|raw }} },
        manual_required: { icon: 'fa-triangle-exclamation', className: 'text-warning', label: {{ t('agent.state.manual_required')|json_encode|raw }} },
        update_available: { icon: 'fa-circle-arrow-up', className: 'text-info', label: {{ t('agent.state.update_available')|json_encode|raw }} },
        pending: { icon: 'fa-clock', className: 'text-secondary', label: {{ t('agent.state.pending')|json_encode|raw }} },
        accepted: { icon: 'fa-circle-check', className: 'text-info', label: {{ t('agent.state.accepted')|json_encode|raw }} },
        downloading: { icon: 'fa-download', className: 'text-info', label: {{ t('agent.state.downloading')|json_encode|raw }} },
        installing: { icon: 'fa-gears', className: 'text-warning', label: {{ t('agent.state.installing')|json_encode|raw }} },
        awaiting_restart: { icon: 'fa-rotate', className: 'text-warning', label: {{ t('agent.state.awaiting_restart')|json_encode|raw }} },
        failed: { icon: 'fa-circle-xmark', className: 'text-danger', label: {{ t('agent.state.failed')|json_encode|raw }} }
    };
    const text = {
        update: {{ t('agent.update')|json_encode|raw }},
        updateTo: {{ t('agent.update_to', {version: '__VERSION__'})|json_encode|raw }},
        retry: {{ t('agent.retry_update')|json_encode|raw }},
        requesting: {{ t('agent.state.pending')|json_encode|raw }},
        requestError: {{ t('agent.state.failed')|json_encode|raw }}
    };
    const rows = Array.from(document.querySelectorAll('[data-agent-row]'));
    const rowsById = new Map(rows.map((row) => [row.dataset.serverId, row]));
    const trackedServerIds = new Set();
    const filter = document.querySelector('[data-agent-filter]');
    const filterValue = document.querySelector('[data-agent-filter-value]');
    const emptyState = document.querySelector('[data-agent-filter-empty]');
    const csrfForm = document.getElementById('agent-update-csrf');
    let pollTimer = null;

    function normalizedFilter(value) {
        return ['current', 'outdated'].includes(value) ? value : 'all';
    }

    function updateFilterUrl(value) {
        const url = new URL(window.location.href);
        if (value === 'all') url.searchParams.delete('agent'); else url.searchParams.set('agent', value);
        window.history.replaceState(null, '', url);
        if (filterValue) filterValue.value = value;
        document.querySelectorAll('[data-server-sort-link]').forEach((link) => {
            const sortUrl = new URL(link.href, window.location.origin);
            if (value === 'all') sortUrl.searchParams.delete('agent'); else sortUrl.searchParams.set('agent', value);
            link.href = sortUrl.pathname + sortUrl.search;
        });
    }

    function applyAgentFilter() {
        const value = filter ? normalizedFilter(filter.value) : 'all';
        let visible = 0;
        rows.forEach((row) => {
            const outdated = row.dataset.agentOutdated;
            const show = value === 'all' || (value === 'current' && outdated === '0') || (value === 'outdated' && outdated === '1');
            row.hidden = !show;
            if (show) visible += 1;
        });
        if (emptyState) emptyState.hidden = visible !== 0;
        updateFilterUrl(value);
    }

    function createIcon(meta) {
        const icon = document.createElement('i');
        icon.className = `fas ${meta.icon} ${meta.className}`;
        icon.setAttribute('aria-label', meta.label);
        icon.title = meta.label;
        return icon;
    }

    function createUpdateButton(row, status, meta) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `btn btn-link btn-sm p-0 align-baseline ${meta.className}`;
        button.dataset.agentUpdateButton = '';
        button.dataset.updateUrl = `/servers/${row.dataset.serverId}/agent/update`;
        button.title = status.state === 'failed' ? text.retry : text.updateTo.replace('__VERSION__', status.available_version || '');
        button.setAttribute('aria-label', status.state === 'failed' ? text.retry : text.update);
        button.appendChild(createIcon(meta));
        return button;
    }

    function renderStatus(row, status) {
        const state = stateMeta[status.state] ? status.state : 'unknown';
        const meta = stateMeta[state];
        row.dataset.agentState = state;
        row.dataset.agentOutdated = status.is_outdated === true ? '1' : (status.is_outdated === false ? '0' : 'unknown');
        const version = row.querySelector('[data-agent-version]');
        if (version) version.textContent = status.installed_version || '—';
        let control = row.querySelector('[data-agent-state-control]');
        if (!control) {
            control = document.createElement('span');
            control.className = 'ms-1';
            control.dataset.agentStateControl = '';
            const versionLink = version ? version.closest('a') : null;
            (versionLink || version)?.after(control);
        }
        if (!control) return;
        control.replaceChildren();
        const actionable = canManageAgents && status.can_update === true && ['update_available', 'failed'].includes(state);
        control.appendChild(actionable ? createUpdateButton(row, status, meta) : createIcon(meta));
        if (activeStates.has(state)) trackedServerIds.add(row.dataset.serverId); else trackedServerIds.delete(row.dataset.serverId);
        applyAgentFilter();
    }

    function renderTransient(row, iconClass, label) {
        const control = row.querySelector('[data-agent-state-control]');
        if (!control) return;
        const icon = document.createElement('i');
        icon.className = iconClass;
        icon.title = label;
        icon.setAttribute('aria-label', label);
        control.replaceChildren(icon);
    }

    async function fetchStatuses(serverIds) {
        if (serverIds.length === 0) return {};
        const response = await fetch('/api/agent-updates/status?ids=' + encodeURIComponent(serverIds.join(',')), {
            headers: { Accept: 'application/json' },
            cache: 'no-store'
        });
        if (!response.ok) throw new Error('Cannot fetch agent update statuses.');
        const payload = await response.json();
        return payload.statuses || {};
    }

    async function refreshStatuses(serverIds) {
        const statuses = await fetchStatuses(serverIds);
        serverIds.forEach((serverId) => {
            const row = rowsById.get(String(serverId));
            const status = statuses[String(serverId)] ?? statuses[serverId];
            if (row && status) renderStatus(row, status);
        });
    }

    function schedulePoll(delay = 2000) {
        window.clearTimeout(pollTimer);
        if (trackedServerIds.size === 0) {
            pollTimer = null;
            return;
        }
        pollTimer = window.setTimeout(pollStatuses, delay);
    }

    async function pollStatuses() {
        const ids = Array.from(trackedServerIds);
        try {
            await refreshStatuses(ids);
            schedulePoll();
        } catch (error) {
            console.error(error);
            schedulePoll(5000);
        }
    }

    document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest('[data-agent-update-button]');
        if (!(button instanceof HTMLButtonElement) || !csrfForm) return;
        const row = button.closest('[data-agent-row]');
        if (!(row instanceof HTMLTableRowElement)) return;
        button.disabled = true;
        renderTransient(row, 'fas fa-spinner fa-spin text-info', text.requesting);
        try {
            const response = await fetch(button.dataset.updateUrl, {
                method: 'POST',
                headers: { Accept: 'application/json' },
                body: new FormData(csrfForm)
            });
            const payload = await response.json();
            if (!response.ok || !payload.status) throw new Error(payload.error || 'Agent update request failed.');
            renderStatus(row, payload.status);
            trackedServerIds.add(row.dataset.serverId);
            schedulePoll(1000);
        } catch (error) {
            console.error(error);
            renderTransient(row, 'fas fa-triangle-exclamation text-danger', text.requestError);
            window.setTimeout(async () => {
                try { await refreshStatuses([row.dataset.serverId]); } catch (refreshError) { console.error(refreshError); }
            }, 2000);
        }
    });

    if (filter) {
        const initial = normalizedFilter(new URL(window.location.href).searchParams.get('agent'));
        filter.value = initial;
        filter.addEventListener('change', applyAgentFilter);
    }
    rows.forEach((row) => { if (activeStates.has(row.dataset.agentState)) trackedServerIds.add(row.dataset.serverId); });
    applyAgentFilter();
    schedulePoll();
})();
</script>
{% endif %}
{% endblock %}