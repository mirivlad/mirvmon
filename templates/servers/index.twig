{% extends "layout.twig" %}
{% set page_title = t('servers.title') %}

{% block content %}
{% set update_indicators = {
    current: ['fa-circle-check', 'text-success', t('agent.state.current')],
    unknown: ['fa-circle-question', 'text-secondary', t('agent.state.unknown')],
    manual_required: ['fa-triangle-exclamation', 'text-warning', t('agent.state.manual_required')],
    update_available: ['fa-circle-arrow-up', 'text-info', t('agent.state.update_available')],
    pending: ['fa-clock', 'text-secondary', t('agent.state.pending')],
    accepted: ['fa-circle-check', 'text-info', t('agent.state.accepted')],
    downloading: ['fa-download', 'text-info', t('agent.state.downloading')],
    installing: ['fa-gears', 'text-warning', t('agent.state.installing')],
    awaiting_restart: ['fa-rotate', 'text-warning', t('agent.state.awaiting_restart')],
    failed: ['fa-circle-xmark', 'text-danger', t('agent.state.failed')]
} %}

<header class="app-page-header">
    <div class="app-page-header-main">
        <p class="page-eyebrow">MirvMon</p>
        <h1><i class="fas fa-server" aria-hidden="true"></i> {{ t('servers.title') }}</h1>
        <p class="page-subtitle">{{ t('ui19.servers.subtitle') }}</p>
    </div>
    <div class="app-page-actions">
        {% if session.role == 'admin' and agent_update_summary %}
        <form method="post" action="/servers/agents/update-outdated"
              data-agent-bulk-update-form
              data-target-version="{{ agent_update_summary.target_version }}"
              data-confirm-template="{{ t('agent.update_all_confirm', {count: '__COUNT__', version: '__VERSION__'}) }}">
            {% include "partials/csrf.twig" %}
            <button type="submit" class="btn btn-outline-primary" data-agent-bulk-update-button
                    {% if agent_update_summary.eligible == 0 %}disabled{% endif %}>
                <i class="fas fa-arrows-rotate" aria-hidden="true"></i>
                {{ t('agent.update_all_outdated') }}
                <span class="badge text-bg-primary ms-1" data-agent-bulk-update-count>{{ agent_update_summary.eligible }}</span>
            </button>
        </form>
        {% endif %}
        <a href="/servers/create" class="btn btn-primary">
            <i class="fas fa-plus" aria-hidden="true"></i> {{ t('servers.add') }}
        </a>
    </div>
</header>
{% if session.role == 'admin' %}
<div class="alert d-none" role="status" data-agent-bulk-feedback></div>
{% endif %}

<form id="server-filters" method="get" action="/servers" class="app-filter-panel" data-server-filter-form>
    <input type="hidden" name="sort" value="{{ sort }}">
    <input type="hidden" name="direction" value="{{ direction|lower }}">

    <div class="server-list-filter-grid">
        <div class="app-filter-field">
            <label for="server-search">{{ t('ui19.servers.search') }}</label>
            <div class="app-search-field">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input id="server-search" class="form-control" type="search" name="q"
                       placeholder="{{ t('ui19.servers.search_placeholder') }}" data-server-search>
            </div>
        </div>
        <div class="app-filter-field">
            <label for="server-group-filter">{{ t('ui19.servers.group') }}</label>
            <select id="server-group-filter" class="form-select" name="group_filter" data-server-group-filter>
                <option value="all">{{ t('ui19.servers.all_groups') }}</option>
            </select>
        </div>
        <div class="app-filter-field">
            <label for="server-status-filter">{{ t('ui19.servers.status') }}</label>
            <select id="server-status-filter" class="form-select" name="status" data-server-status-filter>
                <option value="all">{{ t('ui19.servers.all_statuses') }}</option>
                <option value="online">{{ t('status.online') }}</option>
                <option value="warning">{{ t('status.warning') }}</option>
                <option value="critical">{{ t('status.critical') }}</option>
                <option value="offline">{{ t('status.offline') }}</option>
            </select>
        </div>
        <div class="app-filter-field">
            <label for="server-agent-filter">{{ t('servers.filter.agent.label') }}</label>
            <select id="server-agent-filter" class="form-select" name="agent" data-agent-filter>
                <option value="all">{{ t('servers.filter.agent.all') }}</option>
                <option value="current">{{ t('servers.filter.agent.current') }}</option>
                <option value="outdated">{{ t('servers.filter.agent.outdated') }}</option>
            </select>
        </div>
        <div class="app-filter-actions">
            <button class="btn btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#advanced-server-filters"
                    aria-expanded="false" aria-controls="advanced-server-filters"
                    title="{{ t('ui19.servers.advanced_hint') }}">
                <i class="fas fa-sliders" aria-hidden="true"></i>
                <span class="d-none d-xl-inline">{{ t('ui19.servers.advanced') }}</span>
            </button>
            <a class="btn btn-outline-secondary" href="/servers" title="{{ t('ui19.servers.reset') }}">
                <i class="fas fa-rotate-left" aria-hidden="true"></i>
                <span class="visually-hidden">{{ t('ui19.servers.reset') }}</span>
            </a>
        </div>
    </div>

    <div class="collapse app-advanced-filters" id="advanced-server-filters">
        <div class="app-advanced-filter-grid">
            <div class="app-filter-field">
                <label for="filter-address">{{ t('servers.column.address') }}</label>
                <input id="filter-address" class="form-control" type="search" name="address" value="{{ filters.address }}">
            </div>
            <div class="app-filter-field">
                <label for="filter-description">{{ t('servers.column.description') }}</label>
                <input id="filter-description" class="form-control" type="search" name="description" value="{{ filters.description }}">
            </div>
            <div class="app-filter-field">
                <label for="filter-last-metrics">{{ t('servers.column.last_metrics') }}</label>
                <input id="filter-last-metrics" class="form-control" type="search" name="last_metrics" value="{{ filters.last_metrics }}">
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <a class="btn btn-outline-secondary" href="/servers">{{ t('ui19.servers.reset') }}</a>
            <button class="btn btn-primary" type="submit">
                <i class="fas fa-filter" aria-hidden="true"></i> {{ t('ui19.servers.apply') }}
            </button>
        </div>
    </div>

    <div class="app-filter-meta">
        <span data-server-result-count>{{ t('ui19.servers.results', {count: servers|length}) }}</span>
        <span>{{ t('ui19.servers.advanced_hint') }}</span>
    </div>
</form>

{% if session.role == 'admin' %}
<form id="agent-update-csrf" class="d-none" aria-hidden="true">
    {% include "partials/csrf.twig" %}
</form>
{% endif %}

{% if servers|length > 0 %}
<section class="app-panel" aria-label="{{ t('servers.title') }}">
    <div class="table-responsive" data-server-table>
        <table class="table app-table server-list-table">
            <thead>
                <tr>
                    <th>
                        <a href="{{ sort_urls.name }}" data-server-sort-link class="link-dark text-decoration-none">
                            {{ t('ui19.servers.server') }}{% if sort == 'name' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}
                        </a>
                    </th>
                    <th>
                        <a href="{{ sort_urls.group }}" data-server-sort-link class="link-dark text-decoration-none">
                            {{ t('servers.column.group') }}{% if sort == 'group' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}
                        </a>
                    </th>
                    <th>
                        <a href="{{ sort_urls.last_metrics }}" data-server-sort-link class="link-dark text-decoration-none">
                            {{ t('ui19.servers.health') }}{% if sort == 'last_metrics' %} <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %}"></i>{% endif %}
                        </a>
                    </th>
                    <th>{{ t('servers.column.agent') }}</th>
                    <th>{{ t('common.actions') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for server in servers %}
                {% set agent_known = server.agent_update and server.agent_update.installed_version %}
                {% set agent_outdated = server.agent_update and server.agent_update.is_outdated is same as(true) %}
                {% set agent_filter_state = agent_outdated ? '1' : (agent_known ? '0' : 'unknown') %}
                {% set indicator = server.agent_update ? update_indicators[server.agent_update.state]|default(update_indicators.unknown) : null %}
                {% set search_text = server.name ~ ' ' ~ server.address|default('') ~ ' ' ~ server.description|default('') ~ ' ' ~ server.group_name|default('') %}
                <tr data-agent-row
                    data-server-id="{{ server.id }}"
                    data-server-search="{{ search_text }}"
                    data-server-group="{{ server.group_name|default('') }}"
                    data-server-status="{{ server.status }}"
                    data-agent-outdated="{{ agent_filter_state }}"
                    data-agent-can-update="{{ server.agent_update and server.agent_update.can_update ? '1' : '0' }}"
                    data-agent-state="{{ server.agent_update.state|default('unknown') }}">
                    <td data-label="{{ t('ui19.servers.server') }}">
                        <div class="server-list-identity server-status-{{ server.status }}">
                            {% include "partials/server-status-icon.twig" %}
                            <div class="server-list-primary">
                                <a class="server-list-name" href="/servers/{{ server.id }}">{{ server.name }}</a>
                                <span class="server-list-secondary">
                                    {{ server.address|default('—') }}
                                    {% if server.description %} · {{ server.description }}{% endif %}
                                </span>
                            </div>
                        </div>
                    </td>
                    <td data-label="{{ t('servers.column.group') }}">
                        {% if server.group_name %}
                            <a class="text-decoration-none text-body" href="/groups/{{ server.group_id }}">
                                <i class="fas {{ server.group_icon|default('fa-box') }}" {% if server.group_color %}style="color: {{ server.group_color }}"{% endif %} aria-hidden="true"></i>
                                {{ server.group_name }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td data-label="{{ t('ui19.servers.health') }}">
                        <span class="app-status-badge status-{{ server.status }}">
                            <span class="app-status-dot" aria-hidden="true"></span>
                            {{ t('status.' ~ server.status) }}
                        </span>
                        <span class="server-list-secondary">
                            {% if server.last_metrics_at %}
                                {{ t('ui19.servers.last_sample', {time: server.last_metrics_at|date('d.m.Y H:i:s')}) }}
                            {% else %}
                                {{ t('ui19.servers.no_sample') }}
                            {% endif %}
                        </span>
                    </td>
                    <td data-label="{{ t('servers.column.agent') }}">
                        <a href="/servers/{{ server.id }}?tab=agent" class="text-decoration-none">
                            <span class="badge bg-light text-dark" data-agent-version>{{ server.agent_version|default('—') }}</span>
                        </a>
                        {% if server.agent_update and indicator %}
                            <span class="ms-1" data-agent-state-control>
                                {% if session.role == 'admin' and server.agent_update.can_update and server.agent_update.state in ['update_available', 'failed'] %}
                                    <button type="button"
                                            class="btn btn-link btn-sm p-0 align-baseline {{ indicator[1] }}"
                                            data-agent-update-button
                                            data-update-url="/servers/{{ server.id }}/agent/update"
                                            title="{{ server.agent_update.state == 'failed' ? t('agent.retry_update') : t('agent.update_to', {version: server.agent_update.available_version}) }}"
                                            aria-label="{{ server.agent_update.state == 'failed' ? t('agent.retry_update') : t('agent.update') }}">
                                        <i class="fas {{ indicator[0] }}" aria-hidden="true"></i>
                                    </button>
                                {% else %}
                                    <i class="fas {{ indicator[0] }} {{ indicator[1] }}" aria-label="{{ indicator[2] }}" title="{{ indicator[2] }}"></i>
                                {% endif %}
                            </span>
                        {% endif %}
                    </td>
                    <td data-label="{{ t('common.actions') }}">
                        <div class="d-flex flex-wrap gap-1">
                            {% include "partials/action-button.twig" with {href: '/servers/' ~ server.id, icon: 'fa-eye', label: t('common.view'), class: 'btn-info'} %}
                            {% include "partials/action-button.twig" with {href: '/servers/' ~ server.id ~ '/edit', icon: 'fa-edit', label: t('common.edit'), class: 'btn-outline-primary'} %}
                            {% include "partials/action-button.twig" with {form_action: '/servers/' ~ server.id ~ '/delete', icon: 'fa-trash', label: t('common.delete'), class: 'btn-outline-danger', confirm: t('servers.delete.confirm')} %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="app-empty-state" data-server-filter-empty hidden>
        <span class="app-empty-state-icon"><i class="fas fa-filter-circle-xmark" aria-hidden="true"></i></span>
        <h3>{{ t('ui19.servers.no_matches') }}</h3>
        <a class="btn btn-outline-secondary" href="/servers">{{ t('ui19.servers.reset') }}</a>
    </div>
</section>
{% else %}
<section class="app-panel">
    <div class="app-empty-state">
        <span class="app-empty-state-icon"><i class="fas fa-server" aria-hidden="true"></i></span>
        <h3>{{ t('servers.empty.heading') }}</h3>
        <p>{{ t('ui19.servers.subtitle') }}</p>
        <a href="/servers/create" class="btn btn-primary">
            <i class="fas fa-plus" aria-hidden="true"></i> {{ t('servers.empty.add') }}
        </a>
    </div>
</section>
{% endif %}

{% if servers|length > 0 %}
<script nonce="__MIRVMON_CSP_NONCE__">
(() => {
    'use strict';

    const canManageAgents = {{ session.role == 'admin' ? 'true' : 'false' }};
    const activeStates = new Set(['pending', 'accepted', 'downloading', 'installing', 'awaiting_restart']);
    const stateMeta = {
        current: { icon: 'fa-circle-check', className: 'text-success', label: {{ t('agent.state.current')|json_encode|raw }} },
        unknown: { icon: 'fa-circle-question', className: 'text-secondary', label: {{ t('agent.state.unknown')|json_encode|raw }} },
        manual_required: { icon: 'fa-triangle-exclamation', className: 'text-warning', label: {{ t('agent.state.manual_required')|json_encode|raw }} },
        update_available: { icon: 'fa-circle-arrow-up', className: 'text-info', label: {{ t('agent.state.update_available')|json_encode|raw }} },
        pending: { icon: 'fa-clock', className: 'text-secondary', label: {{ t('agent.state.pending')|json_encode|raw }} },
        accepted: { icon: 'fa-circle-check', className: 'text-info', label: {{ t('agent.state.accepted')|json_encode|raw }} },
        downloading: { icon: 'fa-download', className: 'text-info', label: {{ t('agent.state.downloading')|json_encode|raw }} },
        installing: { icon: 'fa-gears', className: 'text-warning', label: {{ t('agent.state.installing')|json_encode|raw }} },
        awaiting_restart: { icon: 'fa-rotate', className: 'text-warning', label: {{ t('agent.state.awaiting_restart')|json_encode|raw }} },
        failed: { icon: 'fa-circle-xmark', className: 'text-danger', label: {{ t('agent.state.failed')|json_encode|raw }} }
    };
    const text = {
        update: {{ t('agent.update')|json_encode|raw }},
        updateTo: {{ t('agent.update_to', {version: '__VERSION__'})|json_encode|raw }},
        retry: {{ t('agent.retry_update')|json_encode|raw }},
        requesting: {{ t('agent.state.pending')|json_encode|raw }},
        requestError: {{ t('agent.state.failed')|json_encode|raw }},
        bulkResult: {{ t('agent.update_all_result', {scheduled: '__SCHEDULED__', running: '__RUNNING__', manual: '__MANUAL__'})|json_encode|raw }},
        bulkError: {{ t('agent.update_all_error')|json_encode|raw }},
        results: {{ t('ui19.servers.results', {count: '__COUNT__'})|json_encode|raw }}
    };
    const rows = Array.from(document.querySelectorAll('[data-agent-row]'));
    const rowsById = new Map(rows.map((row) => [row.dataset.serverId, row]));
    const trackedServerIds = new Set();
    const search = document.querySelector('[data-server-search]');
    const groupFilter = document.querySelector('[data-server-group-filter]');
    const statusFilter = document.querySelector('[data-server-status-filter]');
    const agentFilter = document.querySelector('[data-agent-filter]');
    const emptyState = document.querySelector('[data-server-filter-empty]');
    const table = document.querySelector('[data-server-table]');
    const resultCount = document.querySelector('[data-server-result-count]');
    const csrfForm = document.getElementById('agent-update-csrf');
    const bulkForm = document.querySelector('[data-agent-bulk-update-form]');
    const bulkButton = document.querySelector('[data-agent-bulk-update-button]');
    const bulkCount = document.querySelector('[data-agent-bulk-update-count]');
    const bulkFeedback = document.querySelector('[data-agent-bulk-feedback]');
    let pollTimer = null;

    function normalizedAgentFilter(value) {
        return ['current', 'outdated'].includes(value) ? value : 'all';
    }

    function normalizedStatus(value) {
        return ['online', 'warning', 'critical', 'offline'].includes(value) ? value : 'all';
    }

    function populateGroups() {
        if (!groupFilter) return;
        const current = new URL(window.location.href).searchParams.get('group_filter') || 'all';
        const groups = Array.from(new Set(rows.map((row) => row.dataset.serverGroup || '').filter(Boolean)))
            .sort((a, b) => a.localeCompare(b));
        groups.forEach((group) => {
            const option = document.createElement('option');
            option.value = group;
            option.textContent = group;
            groupFilter.appendChild(option);
        });
        if (current !== 'all' && !groups.includes(current)) {
            const option = document.createElement('option');
            option.value = current;
            option.textContent = current;
            groupFilter.appendChild(option);
        }
        groupFilter.value = current;
    }

    function updateFilterUrl() {
        const url = new URL(window.location.href);
        const values = {
            q: search instanceof HTMLInputElement ? search.value.trim() : '',
            group_filter: groupFilter instanceof HTMLSelectElement ? groupFilter.value : 'all',
            status: statusFilter instanceof HTMLSelectElement ? statusFilter.value : 'all',
            agent: agentFilter instanceof HTMLSelectElement ? normalizedAgentFilter(agentFilter.value) : 'all'
        };
        Object.entries(values).forEach(([key, value]) => {
            if (!value || value === 'all') url.searchParams.delete(key); else url.searchParams.set(key, value);
        });
        window.history.replaceState(null, '', url.pathname + url.search);
        document.querySelectorAll('[data-server-sort-link]').forEach((link) => {
            const sortUrl = new URL(link.href, window.location.origin);
            Object.entries(values).forEach(([key, value]) => {
                if (!value || value === 'all') sortUrl.searchParams.delete(key); else sortUrl.searchParams.set(key, value);
            });
            link.href = sortUrl.pathname + sortUrl.search;
        });
    }

    function applyFilters() {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLocaleLowerCase() : '';
        const group = groupFilter instanceof HTMLSelectElement ? groupFilter.value : 'all';
        const status = statusFilter instanceof HTMLSelectElement ? normalizedStatus(statusFilter.value) : 'all';
        const agent = agentFilter instanceof HTMLSelectElement ? normalizedAgentFilter(agentFilter.value) : 'all';
        let visible = 0;
        rows.forEach((row) => {
            const haystack = (row.dataset.serverSearch || '').toLocaleLowerCase();
            const matchesSearch = query === '' || haystack.includes(query);
            const matchesGroup = group === 'all' || row.dataset.serverGroup === group;
            const matchesStatus = status === 'all' || row.dataset.serverStatus === status;
            const outdated = row.dataset.agentOutdated;
            const matchesAgent = agent === 'all'
                || (agent === 'current' && outdated === '0')
                || (agent === 'outdated' && outdated === '1');
            const show = matchesSearch && matchesGroup && matchesStatus && matchesAgent;
            row.hidden = !show;
            if (show) visible += 1;
        });
        if (table) table.hidden = visible === 0;
        if (emptyState) emptyState.hidden = visible !== 0;
        if (resultCount) resultCount.textContent = text.results.replace('__COUNT__', String(visible));
        updateFilterUrl();
    }

    function createIcon(meta) {
        const icon = document.createElement('i');
        icon.className = `fas ${meta.icon} ${meta.className}`;
        icon.setAttribute('aria-label', meta.label);
        icon.title = meta.label;
        return icon;
    }

    function createUpdateButton(row, status, meta) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `btn btn-link btn-sm p-0 align-baseline ${meta.className}`;
        button.dataset.agentUpdateButton = '';
        button.dataset.updateUrl = `/servers/${row.dataset.serverId}/agent/update`;
        button.title = status.state === 'failed' ? text.retry : text.updateTo.replace('__VERSION__', status.available_version || '');
        button.setAttribute('aria-label', status.state === 'failed' ? text.retry : text.update);
        button.appendChild(createIcon(meta));
        return button;
    }

    function renderStatus(row, status) {
        const state = stateMeta[status.state] ? status.state : 'unknown';
        const meta = stateMeta[state];
        row.dataset.agentState = state;
        row.dataset.agentOutdated = status.is_outdated === true ? '1' : (status.is_outdated === false ? '0' : 'unknown');
        row.dataset.agentCanUpdate = status.can_update === true ? '1' : '0';
        const version = row.querySelector('[data-agent-version]');
        if (version) version.textContent = status.installed_version || '—';
        let control = row.querySelector('[data-agent-state-control]');
        if (!control) {
            control = document.createElement('span');
            control.className = 'ms-1';
            control.dataset.agentStateControl = '';
            const versionLink = version ? version.closest('a') : null;
            (versionLink || version)?.after(control);
        }
        if (!control) return;
        control.replaceChildren();
        const actionable = canManageAgents && status.can_update === true && ['update_available', 'failed'].includes(state);
        control.appendChild(actionable ? createUpdateButton(row, status, meta) : createIcon(meta));
        if (activeStates.has(state)) trackedServerIds.add(row.dataset.serverId); else trackedServerIds.delete(row.dataset.serverId);
        updateBulkControl();
        applyFilters();
    }

    function updateBulkControl() {
        if (!(bulkButton instanceof HTMLButtonElement)) return;
        const eligible = rows.filter((row) =>
            row.dataset.agentCanUpdate === '1'
            && ['update_available', 'failed'].includes(row.dataset.agentState || '')
        ).length;
        bulkButton.disabled = eligible === 0;
        if (bulkCount) bulkCount.textContent = String(eligible);
    }

    function showBulkFeedback(message, type) {
        if (!(bulkFeedback instanceof HTMLElement)) return;
        bulkFeedback.className = `alert alert-${type}`;
        bulkFeedback.textContent = message;
    }

    function renderTransient(row, iconClass, label) {
        const control = row.querySelector('[data-agent-state-control]');
        if (!control) return;
        const icon = document.createElement('i');
        icon.className = iconClass;
        icon.title = label;
        icon.setAttribute('aria-label', label);
        control.replaceChildren(icon);
    }

    async function fetchStatuses(serverIds) {
        if (serverIds.length === 0) return {};
        const response = await fetch('/api/agent-updates/status?ids=' + encodeURIComponent(serverIds.join(',')), {
            headers: { Accept: 'application/json' },
            cache: 'no-store'
        });
        if (!response.ok) throw new Error('Cannot fetch agent update statuses.');
        const payload = await response.json();
        return payload.statuses || {};
    }

    async function refreshStatuses(serverIds) {
        for (let offset = 0; offset < serverIds.length; offset += 100) {
            const chunk = serverIds.slice(offset, offset + 100);
            const statuses = await fetchStatuses(chunk);
            chunk.forEach((serverId) => {
                const row = rowsById.get(String(serverId));
                const status = statuses[String(serverId)] ?? statuses[serverId];
                if (row && status) renderStatus(row, status);
            });
        }
    }

    function schedulePoll(delay = 2000) {
        window.clearTimeout(pollTimer);
        if (trackedServerIds.size === 0) {
            pollTimer = null;
            return;
        }
        pollTimer = window.setTimeout(pollStatuses, delay);
    }

    async function pollStatuses() {
        const ids = Array.from(trackedServerIds);
        try {
            await refreshStatuses(ids);
            schedulePoll();
        } catch (error) {
            console.error(error);
            schedulePoll(5000);
        }
    }

    bulkForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(bulkForm instanceof HTMLFormElement) || !(bulkButton instanceof HTMLButtonElement)) return;
        const eligible = Number.parseInt(bulkCount?.textContent || '0', 10);
        if (!Number.isFinite(eligible) || eligible <= 0) return;
        const confirmTemplate = bulkForm.dataset.confirmTemplate || '';
        const targetVersion = bulkForm.dataset.targetVersion || '';
        const confirmation = confirmTemplate
            .replace('__COUNT__', String(eligible))
            .replace('__VERSION__', targetVersion);
        if (!window.confirm(confirmation)) return;

        bulkButton.disabled = true;
        try {
            const response = await fetch(bulkForm.action, {
                method: 'POST',
                headers: { Accept: 'application/json' },
                body: new FormData(bulkForm)
            });
            const payload = await response.json();
            if (!response.ok || !payload.result) throw new Error(payload.error || 'Bulk agent update request failed.');
            const result = payload.result;
            const scheduledIds = Array.isArray(result.scheduled_server_ids) ? result.scheduled_server_ids : [];
            await refreshStatuses(scheduledIds);
            scheduledIds.forEach((serverId) => trackedServerIds.add(String(serverId)));
            showBulkFeedback(
                text.bulkResult
                    .replace('__SCHEDULED__', String(result.scheduled || 0))
                    .replace('__RUNNING__', String(result.already_running || 0))
                    .replace('__MANUAL__', String(result.manual_required || 0)),
                'success'
            );
            updateBulkControl();
            schedulePoll(1000);
        } catch (error) {
            console.error(error);
            showBulkFeedback(text.bulkError, 'danger');
            updateBulkControl();
        }
    });

    document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest('[data-agent-update-button]');
        if (!(button instanceof HTMLButtonElement) || !csrfForm) return;
        const row = button.closest('[data-agent-row]');
        if (!(row instanceof HTMLTableRowElement)) return;
        button.disabled = true;
        renderTransient(row, 'fas fa-spinner fa-spin text-info', text.requesting);
        try {
            const response = await fetch(button.dataset.updateUrl, {
                method: 'POST',
                headers: { Accept: 'application/json' },
                body: new FormData(csrfForm)
            });
            const payload = await response.json();
            if (!response.ok || !payload.status) throw new Error(payload.error || 'Agent update request failed.');
            renderStatus(row, payload.status);
            trackedServerIds.add(row.dataset.serverId);
            schedulePoll(1000);
        } catch (error) {
            console.error(error);
            renderTransient(row, 'fas fa-triangle-exclamation text-danger', text.requestError);
            window.setTimeout(async () => {
                try { await refreshStatuses([row.dataset.serverId]); } catch (refreshError) { console.error(refreshError); }
            }, 2000);
        }
    });

    populateGroups();
    const initialUrl = new URL(window.location.href);
    if (search instanceof HTMLInputElement) search.value = initialUrl.searchParams.get('q') || '';
    if (statusFilter instanceof HTMLSelectElement) statusFilter.value = normalizedStatus(initialUrl.searchParams.get('status'));
    if (agentFilter instanceof HTMLSelectElement) agentFilter.value = normalizedAgentFilter(initialUrl.searchParams.get('agent'));

    [groupFilter, statusFilter, agentFilter].forEach((control) => control?.addEventListener('change', applyFilters));
    search?.addEventListener('input', applyFilters);
    rows.forEach((row) => { if (activeStates.has(row.dataset.agentState)) trackedServerIds.add(row.dataset.serverId); });
    updateBulkControl();
    applyFilters();
    schedulePoll();
})();
</script>
{% endif %}
{% endblock %}
