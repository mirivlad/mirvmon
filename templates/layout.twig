<!DOCTYPE html>
<html lang="{{ current_locale() }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    {% set effective_title = page_title|default(title)|default(t('app.name')) %}
    <title>{{ effective_title }} · MirvMon</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/ui19.css">
    <style>
        .server-status-emblem {
            display: inline-flex;
            width: 1.65rem;
            height: 1.65rem;
            flex: 0 0 1.65rem;
            align-items: center;
            justify-content: center;
            color: #fff !important;
            background: var(--app-online) !important;
            border-radius: 50% !important;
            box-shadow: 0 0 0 1px rgba(23, 32, 51, 0.08);
        }

        .server-status-icon.server-status-emblem {
            width: 34px;
            height: 34px;
            flex-basis: 34px;
        }

        .server-status-warning .server-status-emblem {
            background: var(--app-warning) !important;
        }

        .server-status-critical .server-status-emblem {
            background: var(--app-critical) !important;
        }

        .server-status-offline .server-status-emblem {
            background: var(--app-offline) !important;
        }
    </style>
</head>
<body>
    {% if session.username %}
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
        <div class="container-xl">
            <a class="navbar-brand app-brand" href="/" aria-label="MirvMon — {{ t('nav.dashboard') }}">
                <span class="app-brand-mark" aria-hidden="true">
                    <i class="fas fa-wave-square"></i>
                </span>
                <span>MirvMon</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#primaryNavigation"
                    aria-controls="primaryNavigation" aria-expanded="false"
                    aria-label="{{ t('nav.open') }}">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="primaryNavigation">
                <ul class="navbar-nav me-auto app-nav-links">
                    <li class="nav-item">
                        <a class="nav-link" href="/" data-nav-exact="/">
                            <i class="fas fa-table-cells-large" aria-hidden="true"></i>
                            {{ t('nav.dashboard') }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/groups" data-nav-prefix="/groups">
                            <i class="fas fa-layer-group" aria-hidden="true"></i>
                            {{ t('nav.groups') }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/servers" data-nav-prefix="/servers">
                            <i class="fas fa-server" aria-hidden="true"></i>
                            {{ t('nav.servers') }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/alerts" data-nav-prefix="/alerts">
                            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                            {{ t('nav.incidents') }}
                        </a>
                    </li>
                    {% if session.role == 'admin' %}
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle app-nav-button"
                                type="button" id="adminDropdown"
                                data-nav-section="settings"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-gear" aria-hidden="true"></i>
                            {{ t('nav.settings') }}
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                            <li>
                                <a class="dropdown-item" href="/admin/users" data-nav-prefix="/admin/users">
                                    <i class="fas fa-users" aria-hidden="true"></i>
                                    {{ t('nav.users') }}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/admin/notifications" data-nav-exact="/admin/notifications">
                                    <i class="fas fa-paper-plane" aria-hidden="true"></i>
                                    {{ t('nav.notifications') }}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/admin/notifications/queue" data-nav-prefix="/admin/notifications/queue">
                                    <i class="fas fa-list-check" aria-hidden="true"></i>
                                    {{ t('nav.notification_queue') }}
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="/admin/system" data-nav-prefix="/admin/system">
                                    <i class="fas fa-heart-pulse" aria-hidden="true"></i>
                                    {{ t('nav.system') }}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/admin/defaults" data-nav-prefix="/admin/defaults">
                                    <i class="fas fa-sliders" aria-hidden="true"></i>
                                    {{ t('nav.defaults') }}
                                </a>
                            </li>
                        </ul>
                    </li>
                    {% endif %}
                </ul>

                <div class="dropdown">
                    <button class="btn app-user-button dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="app-user-avatar" aria-hidden="true">
                            {{ session.username|slice(0, 1)|upper }}
                        </span>
                        <span class="app-user-name">{{ session.username }}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form method="post" action="/logout">
                                {% include "partials/csrf.twig" %}
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>
                                    {{ t('nav.logout') }}
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
    {% endif %}

    <main class="container-xl app-main">
        {% if session.flash_message is defined and session.flash_message %}
        <div class="alert alert-{{ session.flash_type == "error" ? "danger" : (session.flash_type == "warning" ? "warning" : "success") }} alert-dismissible fade show mb-4"
             role="alert">
            {{ session.flash_message|nl2br }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="{{ t('common.close') }}"></button>
        </div>
        {% endif %}
        {% if system_health is defined %}
            {% include 'partials/system-health-summary.twig' %}
        {% endif %}

        {% block content %}{% endblock %}
        {% if diskIoCharts is defined or uptimeChart is defined or availabilityChart is defined %}
            {% include 'partials/dashboard-extra-charts.twig' %}
        {% endif %}
    </main>

    {% if session.username %}
    <footer class="app-footer">
        <div class="container-xl">
            <span>MirvMon</span>
            <span aria-hidden="true">·</span>
            <span>{{ t('app.release', {version: app_version}) }}</span>
            <span aria-hidden="true">·</span>
            <span>{{ 'now'|date('Y') }}</span>
        </div>
    </footer>
    {% endif %}

    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/js/app.js"></script>
    <script src="/js/ui19.js"></script>
    {% if session.username %}
        {% include 'partials/icon-picker-modal.twig' %}
    {% endif %}
</body>
</html>
