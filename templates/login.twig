{% extends "login-layout.twig" %}
{% set page_title = t('auth.login.title') %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="text-center"><i class="fas fa-sign-in-alt"></i> {{ t('auth.login.heading') }}</h3>
            </div>
            <div class="card-body">
                <form method="post" action="/login" id="loginForm">
                    <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                    <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">

                    <div class="mb-3">
                        <label for="username" class="form-label">{{ t('auth.login.username') }}</label>
                        <input type="text" class="form-control" id="username" name="username" required>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">{{ t('auth.login.password') }}</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" value="1" id="remember_me" name="remember_me">
                        <label class="form-check-label" for="remember_me">
                            {{ t('auth.login.remember') }}
                        </label>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-lock"></i> {{ t('auth.login.submit') }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
