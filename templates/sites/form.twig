{% macro endpoint_card(endpoint, index, expanded) %}
{% set has_content = (endpoint.content_checks_text|default('')|trim != '') or (endpoint.content_checks|default([])|length > 0) %}
{% set auth_type = endpoint.auth_type|default('none') %}
<article class="border rounded-3 p-3 mb-3 bg-white" data-endpoint>
    {% if endpoint.id|default(null) %}<input type="hidden" name="endpoints[{{ index }}][id]" value="{{ endpoint.id }}">{% endif %}
    <input type="hidden" data-primary-value name="endpoints[{{ index }}][is_primary]" value="{{ endpoint.is_primary|default(false) ? '1' : '0' }}">

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div class="min-w-0">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h3 class="h6 mb-0" data-endpoint-title>{{ endpoint.name|default(t('websites.form.endpoint')) }}</h3>
                <span class="badge text-bg-primary {% if not endpoint.is_primary|default(false) %}d-none{% endif %}" data-primary-badge>{{ t('websites.form.primary') }}</span>
            </div>
            <div class="small text-muted text-truncate mt-1" data-endpoint-summary>{{ endpoint.url|default(t('websites.form.not_configured')) }}</div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger" data-remove-endpoint>{{ t('common.delete') }}</button>
    </div>

    <div class="row g-3">
        <div class="col-md-5">
            <label class="form-label">{{ t('common.name') }}</label>
            <input class="form-control" data-field="name" name="endpoints[{{ index }}][name]" value="{{ endpoint.name|default('') }}" maxlength="100" required>
        </div>
        <div class="col-md-7">
            <label class="form-label">URL</label>
            <input class="form-control" type="url" data-field="url" name="endpoints[{{ index }}][url]" value="{{ endpoint.url|default('') }}" placeholder="https://example.org/" required>
        </div>
        <div class="col-sm-6 col-md-3">
            <label class="form-label">{{ t('websites.form.interval') }}</label>
            <input class="form-control" type="number" name="endpoints[{{ index }}][interval_seconds]" value="{{ endpoint.interval_seconds|default(60) }}" min="10" max="86400" required>
        </div>
        <div class="col-sm-6 col-md-3">
            <label class="form-label">{{ t('websites.form.timeout') }}</label>
            <input class="form-control" type="number" name="endpoints[{{ index }}][timeout_seconds]" value="{{ endpoint.timeout_seconds|default(15) }}" min="1" max="60" required>
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <div class="d-flex flex-wrap gap-3 pb-2">
                <label class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" data-status-toggle name="endpoints[{{ index }}][status_check_enabled]" value="1" {% if endpoint.status_check_enabled|default(true) %}checked{% endif %}>
                    <span class="form-check-label">{{ t('websites.form.status_check') }}</span>
                </label>
                <label class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" name="endpoints[{{ index }}][follow_redirects]" value="1" {% if endpoint.follow_redirects|default(true) %}checked{% endif %}>
                    <span class="form-check-label">{{ t('websites.form.redirects') }}</span>
                </label>
                <label class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" name="endpoints[{{ index }}][tls_expiry_enabled]" value="1" {% if endpoint.tls_expiry_enabled|default(false) %}checked{% endif %}>
                    <span class="form-check-label">{{ t('websites.form.tls') }}</span>
                </label>
            </div>
        </div>
        <div class="col-md-5" data-status-options>
            <label class="form-label">{{ t('websites.form.statuses') }}</label>
            <input class="form-control" name="endpoints[{{ index }}][expected_statuses]" value="{{ endpoint.expected_statuses|default('200-299') }}" placeholder="200-299">
        </div>
        <div class="col-md-7 d-flex align-items-end">
            <label class="form-check mb-2">
                <input class="form-check-input" type="checkbox" data-content-toggle {% if has_content %}checked{% endif %}>
                <span class="form-check-label">{{ t('websites.form.content_enabled') }}</span>
            </label>
        </div>
        <div class="col-12 {% if not has_content %}d-none{% endif %}" data-content-options>
            <label class="form-label">{{ t('websites.form.content') }}</label>
            <textarea class="form-control" data-content-field name="endpoints[{{ index }}][content_checks_text]" rows="3" placeholder="{{ t('websites.form.content_help') }}" {% if not has_content %}disabled{% endif %}>{% if endpoint.content_checks_text is defined %}{{ endpoint.content_checks_text }}{% else %}{% for check in endpoint.content_checks|default([]) %}{{ check.needle|default(check.expected_text|default('')) }}{% if not loop.last %}
{% endif %}{% endfor %}{% endif %}</textarea>
        </div>
    </div>

    <details class="mt-3" data-advanced {% if expanded %}open{% endif %}>
        <summary class="fw-semibold text-primary py-2" role="button">{{ t('websites.form.advanced') }}</summary>
        <div class="border-top pt-3 mt-1">
            <div class="row g-3">
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">{{ t('websites.form.method') }}</label>
                    <select class="form-select" data-method name="endpoints[{{ index }}][method]">
                        <option value="GET" {% if endpoint.method|default('GET') == 'GET' %}selected{% endif %}>GET</option>
                        <option value="HEAD" {% if endpoint.method|default('GET') == 'HEAD' %}selected{% endif %}>HEAD</option>
                    </select>
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">{{ t('websites.form.max_redirects') }}</label>
                    <input class="form-control" type="number" name="endpoints[{{ index }}][max_redirects]" value="{{ endpoint.max_redirects|default(10) }}" min="0" max="10">
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">{{ t('websites.form.warning_ms') }}</label>
                    <input class="form-control" type="number" name="endpoints[{{ index }}][warning_total_ms]" value="{{ endpoint.warning_total_ms|default('') }}" min="1" max="60000">
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">{{ t('websites.form.critical_ms') }}</label>
                    <input class="form-control" type="number" name="endpoints[{{ index }}][critical_total_ms]" value="{{ endpoint.critical_total_ms|default('') }}" min="1" max="60000">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <label class="form-check mb-2">
                        <input class="form-check-input" type="radio" data-field="is_primary" name="primary_endpoint" value="{{ index }}" {% if endpoint.is_primary|default(false) %}checked{% endif %}>
                        <span class="form-check-label">{{ t('websites.form.primary_help') }}</span>
                    </label>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <label class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="endpoints[{{ index }}][allow_self_signed]" value="1" {% if endpoint.allow_self_signed|default(false) %}checked{% endif %}>
                        <span class="form-check-label">{{ t('websites.form.self_signed') }}</span>
                    </label>
                </div>
                <div class="col-md-8">
                    <label class="form-label">{{ t('websites.form.redirect_hosts') }}</label>
                    <textarea class="form-control" name="endpoints[{{ index }}][credential_redirect_hosts]" rows="2" placeholder="https://login.example.org">{% if endpoint.credential_redirect_hosts is iterable %}{{ endpoint.credential_redirect_hosts|join('\n') }}{% else %}{{ endpoint.credential_redirect_hosts|default('') }}{% endif %}</textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">{{ t('websites.form.auth') }}</label>
                    <select class="form-select" data-auth-type name="endpoints[{{ index }}][auth_type]">
                        <option value="none" {% if auth_type == 'none' %}selected{% endif %}>{{ t('websites.form.auth_none') }}</option>
                        <option value="basic" {% if auth_type == 'basic' %}selected{% endif %}>Basic</option>
                        <option value="bearer" {% if auth_type == 'bearer' %}selected{% endif %}>Bearer</option>
                    </select>
                </div>
                <div class="col-md-4 {% if auth_type != 'basic' %}d-none{% endif %}" data-auth-username-wrap>
                    <label class="form-label">{{ t('websites.form.username') }}</label>
                    <input class="form-control" data-auth-username name="endpoints[{{ index }}][auth_username]" value="" autocomplete="off" {% if auth_type != 'basic' %}disabled{% endif %}>
                </div>
                <div class="col-md-4 {% if auth_type == 'none' %}d-none{% endif %}" data-auth-secret-wrap>
                    <label class="form-label">{{ t('websites.form.secret') }}{% if endpoint.has_auth|default(false) %} <span class="text-muted fw-normal">({{ t('websites.form.keep_existing') }})</span>{% endif %}</label>
                    <input class="form-control" data-auth-secret type="password" name="endpoints[{{ index }}][auth_secret]" value="" autocomplete="new-password" {% if auth_type == 'none' %}disabled{% endif %}>
                </div>
                <div class="col-12">
                    <label class="form-label">{{ t('websites.form.headers') }}</label>
                    <textarea class="form-control" name="endpoints[{{ index }}][headers_text]" rows="2" placeholder="X-Api-Key: value"></textarea>
                    <div class="form-text">{{ t('websites.form.headers_help') }}</div>
                    {% if endpoint.has_headers|default(false) %}
                    <label class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="endpoints[{{ index }}][clear_headers]" value="1">
                        <span class="form-check-label">{{ t('websites.form.clear_headers') }}</span>
                    </label>
                    {% endif %}
                </div>
            </div>
        </div>
    </details>
</article>
{% endmacro %}

{% import _self as site_form %}
<div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
    <div><p class="page-eyebrow">{{ t('websites.eyebrow') }}</p><h1 class="h2 mb-0">{{ website.id|default(null) ? t('websites.edit') : t('websites.create') }}</h1></div>
    <a class="btn btn-outline-secondary" href="/sites">{{ t('common.back') }}</a>
</div>
{% if form_error %}<div class="alert alert-danger" role="alert">{{ form_error }}</div>{% endif %}
<form method="post" action="{{ form_action }}" data-sites-form data-endpoint-label="{{ t('websites.form.endpoint') }}" data-not-configured-label="{{ t('websites.form.not_configured') }}">
    {% include "partials/csrf.twig" %}
    <section class="card mb-4"><div class="card-body">
        <h2 class="h5 mb-3">{{ t('websites.form.identity') }}</h2>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label" for="website-name">{{ t('common.name') }}</label><input class="form-control" id="website-name" name="name" maxlength="100" required value="{{ website.name|default('') }}"></div>
            <div class="col-md-6"><label class="form-label" for="website-group-id">{{ t('websites.form.group') }}</label><select class="form-select" id="website-group-id" name="group_id"><option value="">{{ t('websites.no_group') }}</option>{% for group in groups %}<option value="{{ group.id }}" {% if website.group_id == group.id %}selected{% endif %}>{{ group.name }}</option>{% endfor %}</select></div>
            <div class="col-12"><label class="form-label" for="website-description">{{ t('common.description') }}</label><textarea class="form-control" id="website-description" name="description" rows="2" maxlength="10000">{{ website.description|default('') }}</textarea></div>
        </div>
    </div></section>

    <section class="card mb-4"><div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div><h2 class="h5 mb-1">{{ t('websites.form.checks') }}</h2><p class="text-muted small mb-0">{{ t('websites.form.checks_help') }}</p></div>
            <button type="button" class="btn btn-sm btn-outline-primary" data-add-endpoint><i class="fas fa-plus me-1" aria-hidden="true"></i>{{ t('websites.form.add_endpoint') }}</button>
        </div>
        <div data-endpoints>
        {% for endpoint in website.endpoints|default([]) %}
            {{ site_form.endpoint_card(endpoint, loop.index0, false) }}
        {% endfor %}
        </div>
        <template data-endpoint-template>
            {{ site_form.endpoint_card({
                name: '', url: '', is_primary: false, method: 'GET', interval_seconds: 60,
                timeout_seconds: 15, follow_redirects: true, max_redirects: 10,
                status_check_enabled: true, expected_statuses: '200-299', content_checks: [],
                warning_total_ms: null, critical_total_ms: null, auth_type: 'none',
                credential_redirect_hosts: [], allow_self_signed: false, tls_expiry_enabled: false
            }, '__INDEX__', false) }}
        </template>
    </div></section>

    <section class="card mb-4"><div class="card-body">
        <h2 class="h5 mb-3">{{ t('websites.form.additional_checks') }}</h2>
        <label class="form-check mb-3">
            <input class="form-check-input" type="checkbox" data-domain-toggle name="domain_check_enabled" value="1" {% if website.domain_check_enabled|default(false) %}checked{% endif %}>
            <span class="form-check-label">{{ t('websites.form.domain_enabled') }}</span>
        </label>
        <div class="row g-3 {% if not website.domain_check_enabled|default(false) %}d-none{% endif %}" data-domain-options>
            <div class="col-md-6">
                <label class="form-label" for="registration_domain">{{ t('websites.form.domain') }}</label>
                <input class="form-control" id="registration_domain" name="registration_domain" value="{{ website.registration_domain|default('') }}" maxlength="253" placeholder="example.org" {% if not website.domain_check_enabled|default(false) %}disabled{% endif %}>
                <div class="form-text">{{ t('websites.form.domain_help') }}</div>
            </div>
        </div>
    </div></section>
    <div class="d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="/sites">{{ t('common.cancel') }}</a><button class="btn btn-primary" type="submit">{{ submit_label }}</button></div>
</form>
