{% extends "layout.twig" %}
{% set page_title = t('websites.title') %}

{% block content %}
<header class="d-flex flex-wrap gap-3 justify-content-between align-items-end mb-4">
    <div>
        <p class="page-eyebrow">{{ t('websites.eyebrow') }}</p>
        <h1 class="h2 mb-1">{{ t('websites.title') }}</h1>
        <p class="text-muted mb-0">{{ t('websites.subtitle') }}</p>
    </div>
    {% if session.role == 'admin' %}
        <a class="btn btn-primary" href="/sites/create"><i class="fas fa-plus me-1" aria-hidden="true"></i>{{ t('websites.create') }}</a>
    {% endif %}
</header>

<form class="card mb-4" method="get" action="/sites">
    <div class="card-body row g-3 align-items-end">
        <div class="col-lg-6">
            <label class="form-label" for="website-search">{{ t('websites.filters.search') }}</label>
            <input class="form-control" id="website-search" name="search" value="{{ filters.search }}" placeholder="{{ t('websites.filters.search_placeholder') }}">
        </div>
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="website-group">{{ t('websites.filters.group') }}</label>
            <select class="form-select" id="website-group" name="group_id">
                <option value="">{{ t('websites.filters.all') }}</option>
                {% for option in group_options %}<option value="{{ option.id }}" {% if filters.group_id == option.id ~ '' %}selected{% endif %}>{{ option.name }}</option>{% endfor %}
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label" for="website-status">{{ t('websites.filters.status') }}</label>
            <select class="form-select" id="website-status" name="status">
                <option value="">{{ t('websites.filters.all') }}</option>
                {% for status in ['healthy', 'unavailable', 'problem', 'degraded', 'slow', 'warning', 'critical', 'no_data', 'paused'] %}
                    <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ t('websites.status.' ~ status) }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4 col-lg-1 d-grid"><button class="btn btn-outline-primary" type="submit">{{ t('common.filter') }}</button></div>
    </div>
</form>

{% for group in groups %}
<section class="mb-4" aria-labelledby="website-group-{{ group.id|default('none') }}">
    <h2 class="h5 mb-3" id="website-group-{{ group.id|default('none') }}">{{ group.name|default(t('websites.no_group')) }}</h2>
    <div class="row g-3">
        {% for website in group.websites %}
        <div class="col-md-6 col-xl-4">
            <article class="card h-100 website-card website-status-{{ website.status }}">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between gap-2">
                        <h3 class="h5 mb-0"><a href="/sites/{{ website.id }}/edit">{{ website.name }}</a></h3>
                        <span class="badge text-bg-light">{{ t('websites.status.' ~ website.status) }}</span>
                    </div>
                    <p class="text-muted small mb-0 text-truncate">{{ website.primary_url|default(t('websites.no_endpoint')) }}</p>
                    {% if website.description %}<p class="mb-0 small">{{ website.description }}</p>{% endif %}
                    {% if website.active_problem_count > 0 %}<p class="text-danger small mb-0"><i class="fas fa-triangle-exclamation me-1" aria-hidden="true"></i>{{ t('websites.active_problems', {count: website.active_problem_count}) }}</p>{% endif %}
                    <div class="mt-auto d-flex gap-2 pt-2">
                        <a class="btn btn-sm btn-outline-primary" href="/sites/{{ website.id }}/edit">{{ t('common.edit') }}</a>
                        {% if session.role == 'admin' %}
                            <form method="post" action="/sites/{{ website.id }}/check" class="d-inline">{% include "partials/csrf.twig" %}<button class="btn btn-sm btn-outline-success" type="submit">{{ t('websites.check') }}</button></form>
                        {% endif %}
                    </div>
                </div>
            </article>
        </div>
        {% else %}
            <div class="col-12"><div class="alert alert-secondary mb-0">{{ t('websites.empty') }}</div></div>
        {% endfor %}
    </div>
</section>
{% else %}
<div class="alert alert-secondary">{{ t('websites.empty') }}</div>
{% endfor %}
{% endblock %}
