{% extends "layout.twig" %}
{% set page_title = website.name %}
{% block content %}
<header class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div><p class="page-eyebrow">{{ t('websites.eyebrow') }}</p><h1 class="h2 mb-1">{{ website.name }}</h1><p class="text-muted mb-0">{{ website.description|default('') }}</p></div>
    {% if session.role == 'admin' %}<a class="btn btn-outline-primary" href="/sites/{{ website.id }}/edit">{{ t('common.edit') }}</a>{% endif %}
</header>
<nav class="nav nav-tabs mb-4" aria-label="{{ t('websites.detail.tabs') }}">
    {% for tab in ['overview', 'metrics', 'events', 'settings'] %}<a class="nav-link {% if active_tab == tab %}active{% endif %}" href="/sites/{{ website.id }}?tab={{ tab }}">{{ t('websites.detail.tab.' ~ tab) }}</a>{% endfor %}
</nav>
{% if active_tab == 'overview' %}{% include 'sites/partials/detail-overview.twig' %}{% endif %}
{% if active_tab == 'metrics' %}{% include 'sites/partials/detail-metrics.twig' %}{% endif %}
{% if active_tab == 'events' %}{% include 'sites/partials/detail-events.twig' %}{% endif %}
{% if active_tab == 'settings' %}{% include 'sites/partials/detail-settings.twig' %}{% endif %}
<script src="/js/site-detail.js" defer></script>
{% endblock %}
