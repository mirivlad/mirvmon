<section class="card"><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-2"><h2 class="h5">{{ t('websites.detail.metrics') }}</h2><select class="form-select w-auto" id="website-metrics-endpoint"><option value="">{{ t('websites.detail.all_endpoints') }}</option>{% for endpoint in website.endpoints %}<option value="{{ endpoint.id }}">{{ endpoint.name }}</option>{% endfor %}</select></div><div class="row g-3 mt-1"><div class="col-lg-6"><canvas data-website-chart="availability" aria-label="{{ t('websites.detail.availability') }}"></canvas></div><div class="col-lg-6"><canvas data-website-chart="latency" aria-label="{{ t('websites.detail.latency') }}"></canvas></div></div><div id="data-website-metrics-chart" class="small text-muted mt-3"></div></div></section>
