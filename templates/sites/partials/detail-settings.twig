<section class="card mb-4" id="website-threshold-settings"><div class="card-body"><h2 class="h5">{{ t('websites.detail.settings') }}</h2><form method="post" action="/sites/{{ website.id }}/settings" class="row g-3">{% include 'partials/csrf.twig' %}{% for field in ['tls_warning_days', 'tls_critical_days', 'domain_warning_days', 'domain_critical_days'] %}<div class="col-md-3"><label class="form-label" for="{{ field }}">{{ t('websites.form.' ~ field) }}</label><input class="form-control" type="number" min="0" max="3650" id="{{ field }}" name="{{ field }}" value="{{ website[field] }}" required></div>{% endfor %}<div class="col-12"><button class="btn btn-primary" type="submit">{{ t('common.save') }}</button></div></form></div></section>
<section class="card"><div class="card-body"><h2 class="h5">{{ t('websites.detail.maintenance') }}</h2>{% if maintenance %}<p>{{ t('websites.detail.maintenance_until', {until: maintenance.ends_at}) }}</p><form method="post" action="/sites/{{ website.id }}/maintenance/cancel">{% include 'partials/csrf.twig' %}<button class="btn btn-outline-danger" type="submit">{{ t('websites.detail.cancel_maintenance') }}</button></form>{% else %}<form method="post" action="/sites/{{ website.id }}/maintenance" class="row g-2">{% include 'partials/csrf.twig' %}<div class="col-md-3"><input class="form-control" type="number" name="duration_minutes" min="1" max="10080" placeholder="{{ t('websites.detail.minutes') }}" required></div><div class="col-md-6"><input class="form-control" name="reason" maxlength="255" placeholder="{{ t('websites.detail.reason') }}"></div><div class="col-md-3"><button class="btn btn-outline-primary" type="submit">{{ t('websites.detail.start_maintenance') }}</button></div></form>{% endif %}</div></section>
