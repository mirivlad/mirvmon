<section class="card mb-4"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">{{ t('websites.detail.overview') }}</h2><span class="badge text-bg-light">{{ t('websites.status.' ~ state.status) }}</span></div><p class="mb-0">{{ t('websites.detail.problem_count', {count: state.active_problem_count}) }}</p></div></section>
<div class="row g-3"><div class="col-lg-7"><section class="card h-100"><div class="card-body"><h2 class="h5">{{ t('websites.detail.checks') }}</h2><ul class="list-group list-group-flush">{% for endpoint in website.endpoints %}<li class="list-group-item px-0"><strong>{{ endpoint.name }}</strong><br><span class="text-muted">{{ endpoint.method }} · {{ endpoint.url }}</span><br><small>{{ t('websites.detail.auth') }}: {% if endpoint.has_auth %}{{ t('common.yes') }}{% else %}{{ t('common.no') }}{% endif %} · {{ t('websites.detail.headers') }}: {% if endpoint.has_headers %}{{ t('common.yes') }}{% else %}{{ t('common.no') }}{% endif %}</small></li>{% endfor %}</ul></div></section></div><div class="col-lg-5"><section class="card h-100"><div class="card-body"><h2 class="h5">{{ t('websites.detail.latest') }}</h2>{% for sample in latest %}<p class="mb-2"><strong>#{{ sample.endpoint_id }}</strong> · {{ sample.total_ms|default('—') }} ms · {% if sample.transport_available %}{{ t('websites.status.healthy') }}{% else %}{{ t('websites.status.unavailable') }}{% endif %}</p>{% else %}<p class="text-muted mb-0">{{ t('websites.empty') }}</p>{% endfor %}</div></section></div></div>
