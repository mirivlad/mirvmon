<section class="card" id="incident-timeline"><div class="card-body"><h2 class="h5">{{ t('websites.detail.events') }}</h2>{% for event in active_incidents|merge(incident_history) %}<article class="border-bottom py-2" id="incident-{{ event.id|default(event.source_id|default('')) }}"><strong>{{ event.kind }}</strong> · {{ event.severity }}<br><small class="text-muted">{{ event.created_at }}{% if event.resolved_at %} → {{ event.resolved_at }}{% endif %}</small></article>{% else %}<p class="text-muted mb-0">{{ t('websites.detail.no_events') }}</p>{% endfor %}</div></section>
