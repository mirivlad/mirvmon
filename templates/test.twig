{% extends "layout.twig" %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h2>{{ title }}</h2>
            </div>
            <div class="card-body">
                <p class="lead">{{ message }}</p>
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i> На главную
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}