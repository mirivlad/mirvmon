{% extends "layout.twig" %}
{% set page_title = t('settings.title') %}

{% block content %}
<header class="d-flex flex-wrap gap-3 justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h2 mb-1"><i class="fas fa-sliders" aria-hidden="true"></i> {{ t('settings.title') }}</h1>
        <p class="text-muted mb-0">{{ t('settings.subtitle') }}</p>
    </div>
</header>

<section class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-lg-8">
                <h2 class="h5 mb-2">
                    <i class="fas fa-language me-2" aria-hidden="true"></i>
                    {{ t('settings.language.title') }}
                </h2>
                <p class="text-muted mb-0">{{ t('settings.language.help') }}</p>
            </div>
            <div class="col-lg-4">
                <form method="post" action="/admin/language" class="d-flex gap-2 align-items-end">
                    {% include "partials/csrf.twig" %}
                    <div class="flex-grow-1">
                        <label for="ui_language" class="form-label">{{ t('settings.language.label') }}</label>
                        <select class="form-select" id="ui_language" name="ui_language">
                            {% for code, label in supported_locales() %}
                                <option value="{{ code }}" {% if current_locale() == code %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="btn btn-outline-primary text-nowrap">
                        <i class="fas fa-floppy-disk me-1" aria-hidden="true"></i>
                        {{ t('settings.language.save') }}
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<header class="mb-3">
    <h2 class="h4 mb-1">{{ t('settings.mirvmon.title') }}</h2>
    <p class="text-muted mb-0">{{ t('settings.mirvmon.subtitle') }}</p>
</header>

<section class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0"><i class="fas fa-server me-2" aria-hidden="true"></i>{{ t('system.host.title') }}</h2>
    </div>
    <div class="card-body">
        <p class="text-muted">{{ t('system.host.subtitle') }}</p>
        <form method="post" action="/admin/defaults/host" class="row g-3 align-items-end">
            {% include "partials/csrf.twig" %}
            <div class="col-lg-8">
                <label class="form-label" for="mirvmon-host-server">{{ t('system.host.select') }}</label>
                <select class="form-select" id="mirvmon-host-server" name="server_id">
                    <option value="">{{ t('common.none') }}</option>
                    {% for server in servers %}
                        <option value="{{ server.id }}" {% if selected_host_id == server.id %}selected{% endif %} {% if not server.is_active %}disabled{% endif %}>
                            {{ server.name }}{% if server.address %} — {{ server.address }}{% endif %}{% if not server.is_active %} ({{ t('common.disabled') }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-lg-4">
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk me-1" aria-hidden="true"></i>{{ t('common.save') }}</button>
            </div>
        </form>
    </div>
</section>

<section class="card mb-4" data-connectivity-settings>
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0"><i class="fas fa-tower-broadcast me-2" aria-hidden="true"></i>{{ t('system.connectivity.settings_title') }}</h2>
        <span class="badge bg-secondary">{{ t('system.connectivity.source_' ~ connectivity_settings.source) }}</span>
    </div>
    <div class="card-body">
        <p class="text-muted">{{ t('system.connectivity.settings_help') }}</p>
        <form method="post" action="/admin/defaults/connectivity">
            {% include "partials/csrf.twig" %}
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                <label class="form-label mb-0">{{ t('system.connectivity.targets') }}</label>
                <button class="btn btn-sm btn-outline-primary" type="button" data-connectivity-target-add>
                    <i class="fas fa-plus me-1" aria-hidden="true"></i>{{ t('system.connectivity.add_target') }}
                </button>
            </div>
            <div class="vstack gap-2 mb-3" data-connectivity-targets>
                {% for target in connectivity_settings.targets %}
                    <div class="input-group" data-connectivity-target-row>
                        <input class="form-control" type="text" name="targets[]" value="{{ target }}" maxlength="270" placeholder="dns.google:443" required>
                        <button class="btn btn-outline-danger" type="button" data-connectivity-target-remove title="{{ t('system.connectivity.remove_target') }}" aria-label="{{ t('system.connectivity.remove_target') }}">
                            <i class="fas fa-minus" aria-hidden="true"></i>
                        </button>
                    </div>
                {% endfor %}
            </div>
            <template data-connectivity-target-template>
                <div class="input-group" data-connectivity-target-row>
                    <input class="form-control" type="text" name="targets[]" value="" maxlength="270" placeholder="example.net:443" required>
                    <button class="btn btn-outline-danger" type="button" data-connectivity-target-remove title="{{ t('system.connectivity.remove_target') }}" aria-label="{{ t('system.connectivity.remove_target') }}">
                        <i class="fas fa-minus" aria-hidden="true"></i>
                    </button>
                </div>
            </template>
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="connectivity-quorum">{{ t('system.connectivity.quorum') }}</label>
                    <input class="form-control" id="connectivity-quorum" type="number" name="quorum" min="1" max="{{ connectivity_settings.targets|length }}" value="{{ connectivity_settings.quorum }}" required>
                    <div class="form-text">{{ t('system.connectivity.quorum_help') }}</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="connectivity-interval">{{ t('system.connectivity.interval') }}</label>
                    <input class="form-control" id="connectivity-interval" type="number" name="interval_seconds" min="5" max="300" value="{{ connectivity_settings.interval_seconds }}" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="connectivity-timeout">{{ t('system.connectivity.timeout') }}</label>
                    <input class="form-control" id="connectivity-timeout" type="number" name="timeout_seconds" min="0.1" max="10" step="0.1" value="{{ connectivity_settings.timeout_seconds }}" required>
                </div>
            </div>
            <div class="form-text mt-3">{{ t('system.connectivity.target_help') }}</div>
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk me-1" aria-hidden="true"></i>{{ t('common.save') }}</button>
            </div>
        </form>
    </div>
</section>

<header class="mb-3">
    <h2 class="h4 mb-1">{{ t('settings.defaults.title') }}</h2>
    <p class="text-muted mb-0">{{ t('settings.defaults.subtitle') }}</p>
</header>

<form method="post" action="/admin/defaults/save">
    {% include "partials/csrf.twig" %}

    <div class="row g-3">
        <div class="col-lg-5">
            <section class="card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">
                        <i class="fas fa-plug-circle-xmark me-2" aria-hidden="true"></i>
                        {{ t('settings.defaults.offline.title') }}
                    </h2>
                    <label for="default_offline_timeout" class="form-label">
                        {{ t('settings.defaults.offline_timeout') }}
                    </label>
                    <div class="input-group">
                        <input type="number" class="form-control"
                               id="default_offline_timeout"
                               name="default_offline_timeout"
                               value="{{ settings.default_offline_timeout|default(300) }}"
                               min="30" max="86400" required>
                        <span class="input-group-text">{{ t('common.seconds') }}</span>
                    </div>
                    <p class="form-text mb-0">{{ t('settings.defaults.offline_help') }}</p>
                </div>
            </section>
        </div>

        <div class="col-lg-7">
            <section class="card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">
                        <i class="fas fa-gauge-high me-2" aria-hidden="true"></i>
                        {{ t('settings.defaults.thresholds.title') }}
                    </h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="default_warning_threshold" class="form-label">
                                {{ t('settings.defaults.warning') }}
                            </label>
                            <div class="input-group">
                                <input type="number" class="form-control"
                                       id="default_warning_threshold"
                                       name="default_warning_threshold"
                                       value="{{ settings.default_warning_threshold|default(70) }}"
                                       min="0" max="100" step="0.1" required>
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="default_critical_threshold" class="form-label">
                                {{ t('settings.defaults.critical') }}
                            </label>
                            <div class="input-group">
                                <input type="number" class="form-control"
                                       id="default_critical_threshold"
                                       name="default_critical_threshold"
                                       value="{{ settings.default_critical_threshold|default(90) }}"
                                       min="0" max="100" step="0.1" required>
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <label for="default_duration_seconds" class="form-label">
                                {{ t('settings.defaults.duration') }}
                            </label>
                            <div class="input-group">
                                <input type="number" class="form-control"
                                       id="default_duration_seconds"
                                       name="default_duration_seconds"
                                       value="{{ settings.default_duration_seconds|default(0) }}"
                                       min="0" max="86400" required>
                                <span class="input-group-text">{{ t('common.seconds') }}</span>
                            </div>
                            <p class="form-text mb-0">{{ t('settings.defaults.duration_help') }}</p>
                        </div>
                        <div class="col-12">
                            <label for="default_recovery_duration_seconds" class="form-label">
                                {{ t('settings.defaults.recovery') }}
                            </label>
                            <div class="input-group">
                                <input type="number" class="form-control"
                                       id="default_recovery_duration_seconds"
                                       name="default_recovery_duration_seconds"
                                       value="{{ settings.default_recovery_duration_seconds|default(300) }}"
                                       min="0" max="86400" required>
                                <span class="input-group-text">{{ t('common.seconds') }}</span>
                            </div>
                            <p class="form-text mb-0">{{ t('settings.defaults.recovery_help') }}</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <header class="mt-4 mb-3">
        <h2 class="h4 mb-1">{{ t('settings.defaults.websites.title') }}</h2>
        <p class="text-muted mb-0">{{ t('settings.defaults.websites.help') }}</p>
    </header>

    <div class="row g-3">
        <div class="col-lg-4">
            <section class="card h-100">
                <div class="card-body">
                    <h3 class="h5 mb-3">{{ t('settings.defaults.websites.http') }}</h3>
                    <div class="mb-3">
                        <label for="website_default_interval_seconds" class="form-label">
                            {{ t('settings.defaults.websites.interval') }}
                        </label>
                        <div class="input-group">
                            <input type="number" class="form-control"
                                   id="website_default_interval_seconds"
                                   name="website_default_interval_seconds"
                                   value="{{ settings.website_default_interval_seconds|default(60) }}"
                                   min="10" max="86400" required>
                            <span class="input-group-text">{{ t('common.seconds') }}</span>
                        </div>
                    </div>
                    <div>
                        <label for="website_http_timeout_seconds" class="form-label">
                            {{ t('settings.defaults.websites.timeout') }}
                        </label>
                        <div class="input-group">
                            <input type="number" class="form-control"
                                   id="website_http_timeout_seconds"
                                   name="website_http_timeout_seconds"
                                   value="{{ settings.website_http_timeout_seconds|default(15) }}"
                                   min="1" max="60" required>
                            <span class="input-group-text">{{ t('common.seconds') }}</span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="card h-100">
                <div class="card-body">
                    <h3 class="h5 mb-3">{{ t('settings.defaults.websites.tls') }}</h3>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="website_tls_warning_days" class="form-label">
                                {{ t('settings.defaults.websites.warning_days') }}
                            </label>
                            <input type="number" class="form-control"
                                   id="website_tls_warning_days" name="website_tls_warning_days"
                                   value="{{ settings.website_tls_warning_days|default(21) }}"
                                   min="1" max="3650" required>
                        </div>
                        <div class="col-sm-6">
                            <label for="website_tls_critical_days" class="form-label">
                                {{ t('settings.defaults.websites.critical_days') }}
                            </label>
                            <input type="number" class="form-control"
                                   id="website_tls_critical_days" name="website_tls_critical_days"
                                   value="{{ settings.website_tls_critical_days|default(7) }}"
                                   min="0" max="3650" required>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="card h-100">
                <div class="card-body">
                    <h3 class="h5 mb-3">{{ t('settings.defaults.websites.domain') }}</h3>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="website_domain_warning_days" class="form-label">
                                {{ t('settings.defaults.websites.warning_days') }}
                            </label>
                            <input type="number" class="form-control"
                                   id="website_domain_warning_days" name="website_domain_warning_days"
                                   value="{{ settings.website_domain_warning_days|default(30) }}"
                                   min="1" max="3650" required>
                        </div>
                        <div class="col-sm-6">
                            <label for="website_domain_critical_days" class="form-label">
                                {{ t('settings.defaults.websites.critical_days') }}
                            </label>
                            <input type="number" class="form-control"
                                   id="website_domain_critical_days" name="website_domain_critical_days"
                                   value="{{ settings.website_domain_critical_days|default(7) }}"
                                   min="0" max="3650" required>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="card h-100">
                <div class="card-body">
                    <h3 class="h5 mb-3">{{ t('settings.defaults.websites.worker') }}</h3>
                    <label for="website_worker_concurrency" class="form-label">
                        {{ t('settings.defaults.websites.concurrency') }}
                    </label>
                    <input type="number" class="form-control"
                           id="website_worker_concurrency" name="website_worker_concurrency"
                           value="{{ settings.website_worker_concurrency|default(10) }}"
                           min="1" max="50" required>
                </div>
            </section>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-floppy-disk me-1" aria-hidden="true"></i>
            {{ t('common.save') }}
        </button>
        <a href="/" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
    </div>
</form>
<script src="/js/system-connectivity.js" defer></script>
{% endblock %}
