{% extends "layout.twig" %}
{% set page_title = t('system.title') %}
{% set health_labels = {
    'ok': t('system.status.ok'),
    'warning': t('system.status.warning'),
    'critical': t('system.status.critical'),
    'unknown': t('system.status.unknown')
} %}
{% set health_classes = {
    'ok': 'success',
    'warning': 'warning text-dark',
    'critical': 'danger',
    'unknown': 'secondary'
} %}
{% set server_status_labels = {
    'online': t('status.online'),
    'warning': t('status.warning'),
    'critical': t('status.critical'),
    'offline': t('status.offline')
} %}

{% block content %}
<header class="dashboard-heading mb-4">
    <div>
        <p class="page-eyebrow">MirvMon</p>
        <h1>{{ t('system.title') }}</h1>
        <p class="page-subtitle">{{ t('system.subtitle') }}</p>
    </div>
</header>

<section class="row g-3 mb-4" aria-label="{{ t('system.title') }}">
    <div class="col-md-6">
        <div class="card h-100"><div class="card-body d-flex justify-content-between align-items-center gap-3">
            <div>
                <div class="text-muted small">{{ t('dashboard.system_health.application') }}</div>
                <div class="fw-semibold fs-5">{{ t('system.application.title') }}</div>
            </div>
            <span class="badge bg-{{ health_classes[system.application.status]|default('secondary') }} fs-6">
                {{ health_labels[system.application.status]|default(t('system.status.unknown')) }}
            </span>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card h-100"><div class="card-body d-flex justify-content-between align-items-center gap-3">
            <div>
                <div class="text-muted small">{{ t('dashboard.system_health.host') }}</div>
                <div class="fw-semibold fs-5">{{ system.host.server.name|default(t('system.host.not_configured')) }}</div>
            </div>
            <span class="badge bg-{{ health_classes[system.host.status]|default('secondary') }} fs-6">
                {{ health_labels[system.host.status]|default(t('system.status.unknown')) }}
            </span>
        </div></div>
    </div>
</section>

<section class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0"><i class="fas fa-server me-2" aria-hidden="true"></i>{{ t('system.host.title') }}</h2>
    </div>
    <div class="card-body">
        <p class="text-muted">{{ t('system.host.subtitle') }}</p>
        <form method="post" action="/admin/system/host" class="row g-3 align-items-end">
            {% include "partials/csrf.twig" %}
            <div class="col-lg-8">
                <label class="form-label" for="mirvmon-host-server">{{ t('system.host.select') }}</label>
                <select class="form-select" id="mirvmon-host-server" name="server_id">
                    <option value="">{{ t('common.none') }}</option>
                    {% for server in servers %}
                        <option value="{{ server.id }}" {% if selected_host_id == server.id %}selected{% endif %} {% if not server.is_active %}disabled{% endif %}>
                            {{ server.name }}{% if server.address %} — {{ server.address }}{% endif %}{% if not server.is_active %} ({{ t('common.disabled') }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-lg-4">
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk me-1" aria-hidden="true"></i>{{ t('common.save') }}</button>
            </div>
        </form>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <section class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <h2 class="h5 mb-0"><i class="fas fa-wave-square me-2" aria-hidden="true"></i>{{ t('system.application.title') }}</h2>
                <span class="badge bg-{{ health_classes[system.application.status]|default('secondary') }}">{{ health_labels[system.application.status]|default(t('system.status.unknown')) }}</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">{{ t('system.application.version') }}</dt><dd class="col-sm-7"><code>{{ system.application.version }}</code></dd>
                    <dt class="col-sm-5">{{ t('system.application.environment') }}</dt><dd class="col-sm-7">{{ system.application.environment }}</dd>
                    <dt class="col-sm-5">{{ t('system.application.php') }}</dt><dd class="col-sm-7">{{ system.application.php_version }}</dd>
                    <dt class="col-sm-5">{{ t('system.application.sapi') }}</dt><dd class="col-sm-7">{{ system.application.php_sapi }}</dd>
                    <dt class="col-sm-5">{{ t('system.application.runtime_host') }}</dt><dd class="col-sm-7"><code>{{ system.application.runtime_hostname|default('—') }}</code></dd>
                    <dt class="col-sm-5">{{ t('system.application.timezone') }}</dt><dd class="col-sm-7">{{ system.application.timezone }}</dd>
                </dl>
            </div>
        </section>
    </div>

    <div class="col-lg-6">
        <section class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <h2 class="h5 mb-0"><i class="fas fa-database me-2" aria-hidden="true"></i>{{ t('system.database.title') }}</h2>
                <span class="badge bg-{{ health_classes[system.database.status]|default('secondary') }}">{{ health_labels[system.database.status]|default(t('system.status.unknown')) }}</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">{{ t('system.database.available') }}</dt><dd class="col-sm-7">{{ system.database.available ? t('common.yes') : t('common.no') }}</dd>
                    <dt class="col-sm-5">{{ t('system.database.name') }}</dt><dd class="col-sm-7"><code>{{ system.database.database_name|default('—') }}</code></dd>
                    <dt class="col-sm-5">{{ t('system.database.postgres') }}</dt><dd class="col-sm-7">{{ system.database.postgres_version|default('—') }}</dd>
                    <dt class="col-sm-5">{{ t('system.database.timescale') }}</dt><dd class="col-sm-7">{{ system.database.timescale_version|default('—') }}</dd>
                    <dt class="col-sm-5">{{ t('system.database.size') }}</dt><dd class="col-sm-7">{{ system.database.size_pretty|default('—') }}</dd>
                    <dt class="col-sm-5">{{ t('system.database.latency') }}</dt><dd class="col-sm-7">{{ system.database.latency_ms is not null ? t('system.database.ms', {value: system.database.latency_ms}) : '—' }}</dd>
                </dl>
            </div>
        </section>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <section class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <h2 class="h5 mb-0"><i class="fas fa-gears me-2" aria-hidden="true"></i>{{ t('system.workers.title') }}</h2>
                <span class="badge bg-{{ health_classes[system.workers.status]|default('secondary') }}">{{ health_labels[system.workers.status]|default(t('system.status.unknown')) }}</span>
            </div>
            <div class="card-body">
                {% if system.workers.items is empty %}
                    <p class="text-muted mb-0">{{ t('system.workers.empty') }}</p>
                {% else %}
                    <div class="vstack gap-3">
                        {% for worker in system.workers.items %}
                            <div class="border rounded p-3">
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                    <strong>{{ t('system.worker.' ~ worker.worker) }}</strong>
                                    <span class="badge bg-{{ health_classes[worker.status]|default('secondary') }}">{{ health_labels[worker.status]|default(t('system.status.unknown')) }}</span>
                                </div>
                                {% if worker.last_tick_at %}
                                    <div class="small text-muted">{{ t('system.worker.last_signal') }}: {{ worker.last_tick_at|date('d.m.Y H:i:s') }} · {{ t('system.worker.seconds_ago', {seconds: worker.seconds_since_tick}) }}</div>
                                    <div class="small text-muted">{{ t('system.worker.started') }}: {{ worker.started_at|date('d.m.Y H:i:s') }}</div>
                                {% else %}
                                    <div class="small text-muted">{{ t('system.worker.never') }}</div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </section>
    </div>

    <div class="col-lg-6">
        <section class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <h2 class="h5 mb-0"><i class="fas fa-list-check me-2" aria-hidden="true"></i>{{ t('system.queue.title') }}</h2>
                <span class="badge bg-{{ health_classes[system.queue.status]|default('secondary') }}">{{ health_labels[system.queue.status]|default(t('system.status.unknown')) }}</span>
            </div>
            <div class="card-body">
                <div class="row g-2 mb-3">
                    {% for status in ['pending', 'processing', 'sent', 'failed', 'dead'] %}
                        <div class="col-6 col-xl">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted small">{{ t('system.queue.' ~ status) }}</div>
                                <div class="fs-5 fw-semibold">{{ system.queue.counts[status] }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <dl class="row mb-3">
                    <dt class="col-sm-7">{{ t('system.queue.stale_processing') }}</dt><dd class="col-sm-5">{{ system.queue.stale_processing }}</dd>
                    <dt class="col-sm-7">{{ t('system.queue.overdue_ready') }}</dt><dd class="col-sm-5">{{ system.queue.overdue_ready }}</dd>
                    <dt class="col-sm-7">{{ t('system.queue.oldest_ready') }}</dt><dd class="col-sm-5">{{ system.queue.oldest_ready_seconds is null ? t('system.queue.none_ready') : t('system.worker.seconds_ago', {seconds: system.queue.oldest_ready_seconds}) }}</dd>
                </dl>
                <a class="btn btn-outline-secondary btn-sm" href="/admin/notifications/queue">{{ t('system.queue.open') }}</a>
            </div>
        </section>
    </div>
</div>

<section class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0"><i class="fas fa-computer me-2" aria-hidden="true"></i>{{ t('system.host.title') }}</h2>
        <span class="badge bg-{{ health_classes[system.host.status]|default('secondary') }}">{{ health_labels[system.host.status]|default(t('system.status.unknown')) }}</span>
    </div>
    <div class="card-body">
        {% if not system.host.configured %}
            <p class="text-muted mb-0">{{ t('system.host.not_configured') }}</p>
        {% elseif system.host.server is null %}
            <div class="alert alert-warning mb-0">{{ t('system.host.missing') }}</div>
        {% else %}
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h3 class="h5 mb-1">{{ system.host.server.name }}</h3>
                    {% if system.host.server.address %}<div class="text-muted"><code>{{ system.host.server.address }}</code></div>{% endif %}
                    <div class="small text-muted mt-1">
                        {{ server_status_labels[system.host.server.monitoring_status]|default(t('common.unknown')) }}
                        · {{ t('system.host.last_contact') }}: {{ system.host.server.last_contact_at ? system.host.server.last_contact_at|date('d.m.Y H:i:s') : '—' }}
                        · {{ t('system.host.last_metrics') }}: {{ system.host.server.last_metrics_at ? system.host.server.last_metrics_at|date('d.m.Y H:i:s') : '—' }}
                    </div>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="/servers/{{ system.host.server.id }}">{{ t('system.host.open_server') }}</a>
            </div>

            {% set cpu = system.host.metrics.cpu_load %}
            {% set ram = system.host.metrics.ram_used %}
            {% set ram_total = system.host.metrics.ram_total_gb %}
            {% set uptime = system.host.metrics.uptime %}
            {% set load1 = system.host.metrics.load_1 %}
            {% set load5 = system.host.metrics.load_5 %}
            {% set load15 = system.host.metrics.load_15 %}
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="text-muted small">{{ t('system.host.cpu') }}</div><div class="fs-4 fw-semibold">{{ cpu ? cpu.value|round(1) ~ '%' : '—' }}</div></div></div>
                <div class="col-sm-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="text-muted small">{{ t('system.host.ram') }}</div><div class="fs-4 fw-semibold">{{ ram ? ram.value|round(1) ~ '%' : '—' }}</div>{% if ram_total %}<div class="small text-muted">{{ t('system.host.ram_total') }}: {{ ram_total.value|round(1) }} GB</div>{% endif %}</div></div>
                <div class="col-sm-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="text-muted small">{{ t('system.host.load') }}</div><div class="fs-5 fw-semibold">{% if load1 and load5 and load15 %}{{ load1.value|round(2) }} / {{ load5.value|round(2) }} / {{ load15.value|round(2) }}{% else %}—{% endif %}</div></div></div>
                <div class="col-sm-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="text-muted small">{{ t('system.host.uptime') }}</div><div class="fs-5 fw-semibold">{% if uptime %}{% set uptime_sec = uptime.value %}{% if uptime_sec >= 86400 %}{{ t('system.host.days_hours', {days: (uptime_sec / 86400)|round(0, 'floor'), hours: ((uptime_sec % 86400) / 3600)|round(0, 'floor')}) }}{% else %}{{ t('system.host.hours_minutes', {hours: (uptime_sec / 3600)|round(0, 'floor'), minutes: ((uptime_sec % 3600) / 60)|round(0, 'floor')}) }}{% endif %}{% else %}—{% endif %}</div></div></div>
            </div>

            <h3 class="h6">{{ t('system.host.disks') }}</h3>
            {% if system.host.disks is empty %}
                <p class="text-muted mb-0">{{ t('system.host.no_metrics') }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>{{ t('common.name') }}</th><th>{{ t('server.metrics.used', {value: '%'}) }}</th><th>{{ t('server.metrics.total', {value: 'GB'}) }}</th></tr></thead>
                        <tbody>
                        {% for disk in system.host.disks %}
                            <tr><td><code>{{ disk.name }}</code></td><td>{{ disk.used_percent|round(1) }}%</td><td>{{ disk.total_gb is null ? '—' : disk.total_gb|round(1) ~ ' GB' }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% endif %}
    </div>
</section>
{% endblock %}
