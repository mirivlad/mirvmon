{% extends "layout.twig" %}
{% set page_title = t('incidents.title') %}

{% block content %}
<header class="mb-3">
    <h1 class="h2 mb-1"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> {{ t('incidents.title') }}</h1>
    <p class="text-muted mb-0">{{ t('incidents.subtitle') }}</p>
</header>

<ul class="nav nav-tabs mb-3" aria-label="{{ t('incidents.title') }}">
    <li class="nav-item">
        <a href="/alerts?view=active" class="nav-link {{ view == 'active' ? 'active fw-semibold' : '' }}" {% if view == 'active' %}aria-current="page"{% endif %}>
            <i class="fas fa-bolt me-1" aria-hidden="true"></i>{{ t('incidents.tab.active') }}
        </a>
    </li>
    <li class="nav-item">
        <a href="/alerts?view=history" class="nav-link {{ view == 'history' ? 'active fw-semibold' : '' }}" {% if view == 'history' %}aria-current="page"{% endif %}>
            <i class="fas fa-clock-rotate-left me-1" aria-hidden="true"></i>{{ t('incidents.tab.history') }}
        </a>
    </li>
</ul>

<form method="get" action="/alerts" class="card mb-3">
    <input type="hidden" name="view" value="{{ view }}">
    <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
        <span class="fw-semibold"><i class="fas fa-filter me-1 text-muted" aria-hidden="true"></i>{{ t('incidents.filter.title') }}</span>
        <div class="d-flex gap-2">
            <a href="/alerts?view={{ view }}" class="btn btn-sm btn-outline-secondary">{{ t('incidents.filter.reset') }}</a>
            <button type="submit" class="btn btn-sm btn-primary">{{ t('incidents.filter.apply') }}</button>
        </div>
    </div>
    <div class="card-body py-3">
        <div class="row g-2">
            <div class="col-sm-6 col-xl-2">
                <label class="form-label small mb-1" for="incident-server">{{ t('incidents.filter.server') }}</label>
                <select class="form-select form-select-sm" id="incident-server" name="server_id">
                    <option value="">{{ t('incidents.filter.all_servers') }}</option>
                    {% for server in server_options %}
                    <option value="{{ server.id }}" {{ filters.server_id == server.id ? 'selected' : '' }}>{{ server.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label small mb-1" for="incident-group">{{ t('incidents.filter.group') }}</label>
                <select class="form-select form-select-sm" id="incident-group" name="group_id">
                    <option value="">{{ t('incidents.filter.all_groups') }}</option>
                    {% for group in group_options %}
                    <option value="{{ group.id }}" {{ filters.group_id == group.id ? 'selected' : '' }}>{{ group.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label small mb-1" for="incident-kind">{{ t('incidents.filter.kind') }}</label>
                <select class="form-select form-select-sm" id="incident-kind" name="kind">
                    <option value="">{{ t('incidents.filter.all_kinds') }}</option>
                    {% for kind in ['metric', 'service', 'offline'] %}
                    <option value="{{ kind }}" {{ filters.kind == kind ? 'selected' : '' }}>{{ t('incidents.kind.' ~ kind) }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label small mb-1" for="incident-severity">{{ t('incidents.filter.severity') }}</label>
                <select class="form-select form-select-sm" id="incident-severity" name="severity">
                    <option value="">{{ t('incidents.filter.all_levels') }}</option>
                    <option value="warning" {{ filters.severity == 'warning' ? 'selected' : '' }}>{{ t('alerts.level.warning') }}</option>
                    <option value="critical" {{ filters.severity == 'critical' ? 'selected' : '' }}>{{ t('alerts.level.critical') }}</option>
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label small mb-1" for="incident-from">{{ t('incidents.filter.from') }}</label>
                <input class="form-control form-control-sm" type="date" id="incident-from" name="from" value="{{ filters.from }}">
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label small mb-1" for="incident-to">{{ t('incidents.filter.to') }}</label>
                <input class="form-control form-control-sm" type="date" id="incident-to" name="to" value="{{ filters.to }}">
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        {% if events|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ t('incidents.column.server') }}</th>
                        <th>{{ t('incidents.column.problem') }}</th>
                        <th>{{ t('incidents.column.level') }}</th>
                        <th>{{ t('incidents.column.period') }}</th>
                        <th>{{ t('incidents.column.duration') }}</th>
                        {% if view == 'history' %}<th>{{ t('incidents.column.resolved_by') }}</th>{% endif %}
                        {% if view == 'active' %}<th>{{ t('common.actions') }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                    {% set duration = event.duration_seconds|default(0) %}
                    {% set duration_days = (duration / 86400)|round(0, 'floor') %}
                    {% set duration_hours = ((duration % 86400) / 3600)|round(0, 'floor') %}
                    {% set duration_minutes = ((duration % 3600) / 60)|round(0, 'floor') %}
                    {% set kind_icon = event.kind == 'offline' ? 'fa-link-slash' : (event.kind == 'service' ? 'fa-gears' : 'fa-chart-line') %}
                    {% set metric_key = 'incidents.metric.' ~ event.subject_name %}
                    {% set metric_label = t(metric_key) %}
                    {% if event.kind == 'offline' %}
                        {% set problem_title = t('incidents.problem.offline') %}
                    {% elseif event.kind == 'service' %}
                        {% set problem_title = t('incidents.problem.service', {'name': event.subject_name}) %}
                    {% elseif metric_label != metric_key %}
                        {% set problem_title = metric_label %}
                    {% else %}
                        {% set problem_title = event.subject_name|replace({'_': ' '}) %}
                    {% endif %}
                    <tr>
                        <td>
                            <a href="/servers/{{ event.server_id }}" class="fw-semibold text-decoration-none">{{ event.server_name }}</a>
                            {% if event.group_id %}
                                <div class="small mt-1">
                                    <i class="fas fa-layer-group text-muted me-1" aria-hidden="true"></i>
                                    <a href="/groups/{{ event.group_id }}" class="text-muted text-decoration-none">{{ event.group_name }}</a>
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <div class="fw-semibold">{{ problem_title }}</div>
                            <div class="small text-muted mt-1 d-flex flex-wrap align-items-center gap-2">
                                <span><i class="fas {{ kind_icon }} me-1" aria-hidden="true"></i>{{ t('incidents.kind.' ~ event.kind) }}</span>
                                {% if event.value is not null %}
                                    <span class="fw-semibold text-body">{{ event.value|round(2) }}{% if event.unit %} {{ event.unit }}{% endif %}</span>
                                {% endif %}
                            </div>
                        </td>
                        <td>
                            {% if event.severity == 'critical' %}
                                <span class="badge bg-danger"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> {{ t('alerts.level.critical') }}</span>
                            {% else %}
                                <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> {{ t('alerts.level.warning') }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="small text-nowrap">
                                <span class="text-muted">{{ t('incidents.column.started') }}:</span>
                                <span>{{ event.created_at|date('d.m.Y H:i:s') }}</span>
                            </div>
                            {% if view == 'history' %}
                            <div class="small text-nowrap mt-1">
                                <span class="text-muted">{{ t('incidents.column.finished') }}:</span>
                                <span>{{ event.resolved_at|date('d.m.Y H:i:s') }}</span>
                            </div>
                            {% endif %}
                        </td>
                        <td class="text-nowrap fw-semibold">
                            {% if duration_days > 0 %}{{ duration_days }} {{ t('common.days') }} {% endif %}
                            {% if duration_hours > 0 or duration_days > 0 %}{{ duration_hours }} {{ t('common.hours') }} {% endif %}
                            {{ duration_minutes }} {{ t('common.minutes') }}
                        </td>
                        {% if view == 'history' %}
                        <td><span class="small">{{ event.resolved_by_username ?: t('incidents.resolved.automatic') }}</span></td>
                        {% endif %}
                        {% if view == 'active' %}
                        <td>
                            {% if event.id is not null %}
                                {% include "partials/action-button.twig" with {
                                    form_action: '/alerts/' ~ event.id ~ '/resolve',
                                    icon: 'fa-check',
                                    label: t('alerts.resolve'),
                                    class: 'btn-outline-success',
                                    confirm: t('alerts.resolve.confirm')
                                } %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5 px-3">
            <i class="fas {{ view == 'history' ? 'fa-clock-rotate-left' : 'fa-circle-check' }} fa-3x text-muted mb-3" aria-hidden="true"></i>
            <p class="lead mb-1">{{ t('incidents.empty.' ~ view ~ '.heading') }}</p>
            <p class="text-muted mb-0">{{ t('incidents.empty.' ~ view ~ '.text') }}</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
