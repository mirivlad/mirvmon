{% extends "layout.twig" %}
{% set page_title = t('incidents.title') %}

{% block content %}
<header class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
    <div>
        <p class="page-eyebrow mb-1">{{ t('incidents.title') }}</p>
        <h1 class="h2 mb-1"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> {{ t('incidents.title') }}</h1>
        <p class="text-muted mb-0">{{ t('incidents.subtitle') }}</p>
    </div>
    <div class="btn-group" role="group" aria-label="{{ t('incidents.title') }}">
        <a href="/alerts?view=active" class="btn {{ view == 'active' ? 'btn-primary' : 'btn-outline-primary' }}">
            {{ t('incidents.tab.active') }}
        </a>
        <a href="/alerts?view=history" class="btn {{ view == 'history' ? 'btn-primary' : 'btn-outline-primary' }}">
            {{ t('incidents.tab.history') }}
        </a>
    </div>
</header>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/alerts" class="row g-3 align-items-end">
            <input type="hidden" name="view" value="{{ view }}">
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="incident-server">{{ t('incidents.filter.server') }}</label>
                <select class="form-select" id="incident-server" name="server_id">
                    <option value="">{{ t('incidents.filter.all_servers') }}</option>
                    {% for server in server_options %}
                    <option value="{{ server.id }}" {{ filters.server_id == server.id ? 'selected' : '' }}>{{ server.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="incident-group">{{ t('incidents.filter.group') }}</label>
                <select class="form-select" id="incident-group" name="group_id">
                    <option value="">{{ t('incidents.filter.all_groups') }}</option>
                    {% for group in group_options %}
                    <option value="{{ group.id }}" {{ filters.group_id == group.id ? 'selected' : '' }}>{{ group.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="incident-kind">{{ t('incidents.filter.kind') }}</label>
                <select class="form-select" id="incident-kind" name="kind">
                    <option value="">{{ t('incidents.filter.all_kinds') }}</option>
                    {% for kind in ['metric', 'service', 'offline'] %}
                    <option value="{{ kind }}" {{ filters.kind == kind ? 'selected' : '' }}>{{ t('incidents.kind.' ~ kind) }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="incident-severity">{{ t('incidents.filter.severity') }}</label>
                <select class="form-select" id="incident-severity" name="severity">
                    <option value="">{{ t('incidents.filter.all_levels') }}</option>
                    <option value="warning" {{ filters.severity == 'warning' ? 'selected' : '' }}>{{ t('alerts.level.warning') }}</option>
                    <option value="critical" {{ filters.severity == 'critical' ? 'selected' : '' }}>{{ t('alerts.level.critical') }}</option>
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="incident-from">{{ t('incidents.filter.from') }}</label>
                <input class="form-control" type="date" id="incident-from" name="from" value="{{ filters.from }}">
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="incident-to">{{ t('incidents.filter.to') }}</label>
                <input class="form-control" type="date" id="incident-to" name="to" value="{{ filters.to }}">
            </div>
            <div class="col-12 d-flex gap-2 justify-content-end">
                <a href="/alerts?view={{ view }}" class="btn btn-outline-secondary">{{ t('incidents.filter.reset') }}</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-filter" aria-hidden="true"></i> {{ t('incidents.filter.apply') }}</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        {% if events|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ t('incidents.column.server') }}</th>
                        <th>{{ t('incidents.column.group') }}</th>
                        <th>{{ t('incidents.column.problem') }}</th>
                        <th>{{ t('incidents.column.level') }}</th>
                        <th>{{ t('incidents.column.started') }}</th>
                        {% if view == 'history' %}<th>{{ t('incidents.column.finished') }}</th>{% endif %}
                        <th>{{ t('incidents.column.duration') }}</th>
                        {% if view == 'history' %}<th>{{ t('incidents.column.resolved_by') }}</th>{% endif %}
                        {% if view == 'active' %}<th>{{ t('common.actions') }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                    {% set duration = event.duration_seconds|default(0) %}
                    {% set duration_days = (duration / 86400)|round(0, 'floor') %}
                    {% set duration_hours = ((duration % 86400) / 3600)|round(0, 'floor') %}
                    {% set duration_minutes = ((duration % 3600) / 60)|round(0, 'floor') %}
                    <tr>
                        <td>
                            <a href="/servers/{{ event.server_id }}" class="fw-semibold text-decoration-none">{{ event.server_name }}</a>
                        </td>
                        <td>
                            {% if event.group_id %}
                                <a href="/groups/{{ event.group_id }}" class="text-decoration-none">{{ event.group_name }}</a>
                            {% else %}—{% endif %}
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border me-1">{{ t('incidents.kind.' ~ event.kind) }}</span>
                            <code>{{ event.subject_name|replace({'_': ' '}) }}</code>
                            {% if event.value is not null %}
                                <span class="d-block small text-muted">{{ event.value|round(2) }}{{ event.unit|default('') }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if event.severity == 'critical' %}
                                <span class="badge bg-danger"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> {{ t('alerts.level.critical') }}</span>
                            {% else %}
                                <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> {{ t('alerts.level.warning') }}</span>
                            {% endif %}
                        </td>
                        <td class="text-nowrap">{{ event.created_at|date('d.m.Y H:i:s') }}</td>
                        {% if view == 'history' %}
                        <td class="text-nowrap">{{ event.resolved_at|date('d.m.Y H:i:s') }}</td>
                        {% endif %}
                        <td class="text-nowrap">
                            {% if duration_days > 0 %}{{ duration_days }} {{ t('common.days') }} {% endif %}
                            {% if duration_hours > 0 or duration_days > 0 %}{{ duration_hours }}h {% endif %}
                            {{ duration_minutes }}m
                        </td>
                        {% if view == 'history' %}
                        <td>{{ event.resolved_by_username ?: t('incidents.resolved.automatic') }}</td>
                        {% endif %}
                        {% if view == 'active' %}
                        <td>
                            {% include "partials/action-button.twig" with {
                                form_action: '/alerts/' ~ event.id ~ '/resolve',
                                icon: 'fa-check',
                                label: t('alerts.resolve'),
                                class: 'btn-outline-success',
                                confirm: t('alerts.resolve.confirm')
                            } %}
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5 px-3">
            <i class="fas {{ view == 'history' ? 'fa-clock-rotate-left' : 'fa-circle-check' }} fa-3x text-muted mb-3" aria-hidden="true"></i>
            <p class="lead mb-1">{{ t('incidents.empty.' ~ view ~ '.heading') }}</p>
            <p class="text-muted mb-0">{{ t('incidents.empty.' ~ view ~ '.text') }}</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
