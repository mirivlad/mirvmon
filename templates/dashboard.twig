{% extends "layout.twig" %}
{% set page_title = t('dashboard.title') %}
{% set status_labels = {
    'online': t('status.online'),
    'warning': t('status.warning'),
    'critical': t('status.critical'),
    'offline': t('status.offline')
} %}
{% block content %}
<header class="dashboard-heading">
    <div>
        <p class="page-eyebrow">{{ t('dashboard.eyebrow') }}</p>
        <h1>{{ t('dashboard.title') }}</h1>
        <p class="page-subtitle">{{ t('dashboard.subtitle') }}</p>
    </div>
    <a href="/servers/create" class="btn btn-primary dashboard-add-button">
        <i class="fas fa-plus" aria-hidden="true"></i>
        {{ t('dashboard.add_server') }}
    </a>
</header>

<section class="summary-grid" aria-label="{{ t('dashboard.title') }}">
    <article class="summary-card summary-card-total">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-server"></i></span>
        <div>
            <span class="summary-label">{{ t('dashboard.summary.total') }}</span>
            <strong class="summary-value" data-summary="total">{{ stats.total_servers }}</strong>
        </div>
    </article>
    <a href="/?status=online" class="summary-card summary-card-online text-reset text-decoration-none">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-circle-check"></i></span>
        <div>
            <span class="summary-label">{{ t('dashboard.summary.online') }}</span>
            <strong class="summary-value" data-summary="online">{{ stats.online_servers }}</strong>
        </div>
    </a>
    <a href="/?status=warning" class="summary-card summary-card-warning text-reset text-decoration-none">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-triangle-exclamation"></i></span>
        <div>
            <span class="summary-label">{{ t('dashboard.summary.warning') }}</span>
            <strong class="summary-value" data-summary="warning">{{ stats.warning_servers }}</strong>
        </div>
    </a>
    <a href="/?status=critical" class="summary-card summary-card-critical text-reset text-decoration-none">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-circle-exclamation"></i></span>
        <div>
            <span class="summary-label">{{ t('dashboard.summary.critical') }}</span>
            <strong class="summary-value" data-summary="critical">{{ stats.critical_servers }}</strong>
        </div>
    </a>
    <a href="/?status=offline" class="summary-card summary-card-offline text-reset text-decoration-none">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-plug-circle-xmark"></i></span>
        <div>
            <span class="summary-label">{{ t('dashboard.summary.offline') }}</span>
            <strong class="summary-value" data-summary="offline">{{ stats.offline_servers }}</strong>
        </div>
    </a>
</section>

<section class="card mb-4" aria-labelledby="dashboard-attention-title">
    <div class="card-header d-flex justify-content-between align-items-center gap-3">
        <h2 class="h5 mb-0" id="dashboard-attention-title">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            {{ t('incidents.attention.title') }}
        </h2>
        <a href="/alerts?view=active" class="small text-decoration-none">{{ t('incidents.attention.all') }}</a>
    </div>
    {% if attention|length > 0 %}
    <div class="list-group list-group-flush">
        {% for issue in attention %}
        <div class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div class="min-w-0">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a href="/servers/{{ issue.server_id }}" class="fw-semibold text-decoration-none">{{ issue.server_name }}</a>
                    {% if issue.group_id %}
                    <a href="/groups/{{ issue.group_id }}" class="text-muted small text-decoration-none">· {{ issue.group_name }}</a>
                    {% endif %}
                </div>
                <div class="small mt-1">
                    <span class="badge bg-light text-dark border me-1">{{ t('incidents.kind.' ~ issue.kind) }}</span>
                    <code>{{ issue.subject_name|replace({'_': ' '}) }}</code>
                    {% if issue.created_at %}
                    <span class="text-muted ms-1">· {{ issue.created_at|date('d.m.Y H:i') }}</span>
                    {% endif %}
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge {{ issue.severity == 'critical' ? 'bg-danger' : 'bg-warning text-dark' }}">
                    {{ issue.severity == 'critical' ? t('alerts.level.critical') : t('alerts.level.warning') }}
                </span>
                <a href="/alerts?view=active&server_id={{ issue.server_id }}" class="btn btn-sm btn-outline-secondary">
                    {{ t('common.details') }}
                </a>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="card-body text-muted">{{ t('incidents.attention.empty') }}</div>
    {% endif %}
</section>

{% if groups|length == 0 %}
<section class="empty-state">
    <span class="empty-state-icon" aria-hidden="true"><i class="fas fa-server"></i></span>
    <h2>{{ t('dashboard.empty.heading') }}</h2>
    <p>{{ t('dashboard.empty.text') }}</p>
    <a href="/servers/create" class="btn btn-primary">
        <i class="fas fa-plus" aria-hidden="true"></i>
        {{ t('dashboard.add_server') }}
    </a>
</section>
{% else %}
<section class="dashboard-toolbar" aria-label="{{ t('common.filter') }}">
    <div class="dashboard-search">
        <label class="visually-hidden" for="dashboard-search">{{ t('common.search') }}</label>
        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        <input id="dashboard-search" type="search" class="form-control"
               placeholder="{{ t('dashboard.search.placeholder') }}" autocomplete="off">
    </div>
    <div>
        <label class="visually-hidden" for="dashboard-status-filter">{{ t('common.status') }}</label>
        <select id="dashboard-status-filter" class="form-select">
            <option value="all">{{ t('dashboard.filter.all_statuses') }}</option>
            <option value="online">{{ t('status.online') }}</option>
            <option value="warning">{{ t('status.warning') }}</option>
            <option value="critical">{{ t('status.critical') }}</option>
            <option value="offline">{{ t('status.offline') }}</option>
        </select>
    </div>
    <div>
        <label class="visually-hidden" for="dashboard-sort">{{ t('common.filter') }}</label>
        <select id="dashboard-sort" class="form-select">
            <option value="name">{{ t('dashboard.sort.name') }}</option>
            <option value="status">{{ t('dashboard.sort.status') }}</option>
            <option value="updated">{{ t('dashboard.sort.updated') }}</option>
        </select>
    </div>
    <span class="dashboard-result-count" id="dashboard-result-count"
          data-count-template="{{ t('dashboard.shown', {count: '__COUNT__'}) }}"
          data-no-updates="{{ t('dashboard.no_updates') }}"
          data-locale="{{ current_locale() }}">
        {{ t('dashboard.shown', {count: stats.total_servers}) }}
    </span>
</section>

<div id="dashboard-groups">
    {% for groupKey, group in groups %}
    {% set panelId = 'dashboard-group-' ~ loop.index %}
    <section class="dashboard-group" data-dashboard-group>
        <button type="button" class="dashboard-group-header"
                data-group-toggle="{{ groupKey }}"
                aria-expanded="true" aria-controls="{{ panelId }}">
            <span class="dashboard-group-title">
                <span class="dashboard-group-icon" aria-hidden="true">
                    <i class="fas {{ group.icon|default('fa-server')|replace({'fas ': ''}) }}"></i>
                </span>
                <span>{{ group.name }}</span>
            </span>
            <span class="dashboard-group-meta">
                <span class="dashboard-group-count" data-group-count>{{ group.servers|length }}</span>
                <i class="fas fa-chevron-up dashboard-group-chevron" aria-hidden="true"></i>
            </span>
        </button>

        <div id="{{ panelId }}" class="dashboard-group-panel">
            <div class="server-grid" data-server-grid>
                {% for server in group.servers %}
                {% set disk_metric = server.latest_metrics['disk_used_root'] ?? server.latest_metrics['disk_used'] ?? null %}
                <article class="server-grid-item"
                         data-server-item
                         data-server-id="{{ server.id }}"
                         data-server-name="{{ server.name|lower }}"
                         data-server-status="{{ server.status }}"
                         data-last-update="{{ server.last_metrics_at ? server.last_metrics_at|date('U') : 0 }}">
                    <a href="/servers/{{ server.id }}"
                       class="server-card server-status-{{ server.status }}"
                       id="server-card-{{ server.id }}">
                        <div class="server-card-header">
                            <div class="server-identity">
                                {% include "partials/server-status-icon.twig" with {
                                    icon_container_class: 'server-status-icon',
                                    icon_id: 'status-icon-' ~ server.id
                                } %}
                                <div class="server-title-wrap">
                                    <h3 class="server-name" title="{{ server.name }}">{{ server.name }}</h3>
                                    <span class="server-status-label" id="status-label-{{ server.id }}">
                                        {{ status_labels[server.status] }}
                                    </span>
                                </div>
                            </div>
                            <span id="alert-count-{{ server.id }}"
                                  class="server-alert-count{% if server.active_alerts == 0 %} d-none{% endif %}">
                                <i class="fas fa-bell" aria-hidden="true"></i>
                                <span>{{ server.active_alerts }}</span>
                                <span class="visually-hidden">{{ t('nav.incidents') }}</span>
                            </span>
                        </div>

                        <dl class="server-metrics">
                            <div class="server-metric">
                                <dt>{{ t('dashboard.metric.cpu') }}</dt>
                                <dd id="cpu-val-{{ server.id }}">
                                    {% if server.latest_metrics['cpu_load'] is defined %}
                                        {{ server.latest_metrics['cpu_load'].value|round(1) }}%
                                    {% else %}—{% endif %}
                                </dd>
                            </div>
                            <div class="server-metric">
                                <dt>{{ t('dashboard.metric.ram') }}</dt>
                                <dd id="ram-val-{{ server.id }}">
                                    {% if server.latest_metrics['ram_used'] is defined %}
                                        {{ server.latest_metrics['ram_used'].value|round(1) }}%
                                    {% else %}—{% endif %}
                                </dd>
                            </div>
                            <div class="server-metric">
                                <dt>{{ t('dashboard.metric.disk') }}</dt>
                                <dd id="disk-val-{{ server.id }}">
                                    {% if disk_metric is not null %}
                                        {{ disk_metric.value|round(1) }}%
                                    {% else %}—{% endif %}
                                </dd>
                            </div>
                        </dl>

                        <div class="server-card-footer">
                            {% if server.latest_metrics['uptime'] is defined %}
                            <span class="server-uptime">
                                <i class="fas fa-clock" aria-hidden="true"></i>
                                {% set uptime_sec = server.latest_metrics['uptime'].value %}
                                {% if uptime_sec >= 86400 %}
                                    {{ (uptime_sec / 86400)|round(0, 'floor') }} {{ t('common.days') }}
                                    {{ ((uptime_sec % 86400) / 3600)|round(0, 'floor') }} {{ t('common.hours') }}
                                {% elseif uptime_sec >= 3600 %}
                                    {{ (uptime_sec / 3600)|round(0, 'floor') }} {{ t('common.hours') }}
                                    {{ ((uptime_sec % 3600) / 60)|round(0, 'floor') }} {{ t('common.minutes') }}
                                {% else %}
                                    {{ (uptime_sec / 60)|round(0, 'floor') }} {{ t('common.minutes') }}
                                {% endif %}
                            </span>
                            {% else %}
                            <span class="server-uptime">{{ t('dashboard.uptime', {value: '—'}) }}</span>
                            {% endif %}
                            <time class="server-updated-at" id="updated-at-{{ server.id }}"
                                  {% if server.last_metrics_at %}datetime="{{ server.last_metrics_at|date('c') }}"{% endif %}>
                                {% if server.seconds_since_update is not null %}
                                    {{ t('dashboard.updated_seconds', {seconds: server.seconds_since_update}) }}
                                {% else %}
                                    {{ t('dashboard.no_updates') }}
                                {% endif %}
                            </time>
                        </div>
                    </a>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endfor %}
</div>

<section id="dashboard-no-results" class="empty-state empty-state-compact" hidden>
    <span class="empty-state-icon" aria-hidden="true"><i class="fas fa-magnifying-glass"></i></span>
    <h2>{{ t('dashboard.no_results.heading') }}</h2>
    <p>{{ t('dashboard.no_results.text') }}</p>
</section>

<p class="visually-hidden" id="dashboard-live-region" aria-live="polite"></p>
<script src="/js/dashboard.js" defer></script>
{% endif %}
{% endblock %}