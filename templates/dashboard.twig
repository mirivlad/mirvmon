{% extends "layout.twig" %}

{% set status_labels = {
    'online': 'В норме',
    'warning': 'Внимание',
    'critical': 'Критично',
    'offline': 'Нет данных'
} %}
{% block content %}
<header class="dashboard-heading">
    <div>
        <p class="page-eyebrow">Обзор инфраструктуры</p>
        <h1>Состояние систем</h1>
        <p class="page-subtitle">
            Актуальные метрики, доступность и активные алерты в одном представлении.
        </p>
    </div>
    <a href="/servers/create" class="btn btn-primary dashboard-add-button">
        <i class="fas fa-plus" aria-hidden="true"></i>
        Добавить сервер
    </a>
</header>

<section class="summary-grid" aria-label="Сводка состояния">
    <article class="summary-card summary-card-total">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-server"></i></span>
        <div>
            <span class="summary-label">Всего серверов</span>
            <strong class="summary-value" data-summary="total">{{ stats.total_servers }}</strong>
        </div>
    </article>
    <article class="summary-card summary-card-online">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-circle-check"></i></span>
        <div>
            <span class="summary-label">В норме</span>
            <strong class="summary-value" data-summary="online">{{ stats.online_servers }}</strong>
        </div>
    </article>
    <article class="summary-card summary-card-warning">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-triangle-exclamation"></i></span>
        <div>
            <span class="summary-label">Внимание</span>
            <strong class="summary-value" data-summary="warning">{{ stats.warning_servers }}</strong>
        </div>
    </article>
    <article class="summary-card summary-card-critical">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-circle-exclamation"></i></span>
        <div>
            <span class="summary-label">Критично</span>
            <strong class="summary-value" data-summary="critical">{{ stats.critical_servers }}</strong>
        </div>
    </article>
    <article class="summary-card summary-card-offline">
        <span class="summary-icon" aria-hidden="true"><i class="fas fa-plug-circle-xmark"></i></span>
        <div>
            <span class="summary-label">Нет данных</span>
            <strong class="summary-value" data-summary="offline">{{ stats.offline_servers }}</strong>
        </div>
    </article>
</section>

{% if groups|length == 0 %}
<section class="empty-state">
    <span class="empty-state-icon" aria-hidden="true">
        <i class="fas fa-server"></i>
    </span>
    <h2>Добавьте первый сервер</h2>
    <p>MirvMon покажет состояние сразу после первого пакета метрик от агента.</p>
    <a href="/servers/create" class="btn btn-primary">
        <i class="fas fa-plus" aria-hidden="true"></i>
        Добавить сервер
    </a>
</section>
{% else %}
<section class="dashboard-toolbar" aria-label="Фильтры серверов">
    <div class="dashboard-search">
        <label class="visually-hidden" for="dashboard-search">Поиск сервера</label>
        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        <input id="dashboard-search" type="search" class="form-control"
               placeholder="Найти сервер…" autocomplete="off">
    </div>
    <div>
        <label class="visually-hidden" for="dashboard-status-filter">Статус</label>
        <select id="dashboard-status-filter" class="form-select">
            <option value="all">Все статусы</option>
            <option value="online">В норме</option>
            <option value="warning">Внимание</option>
            <option value="critical">Критично</option>
            <option value="offline">Нет данных</option>
        </select>
    </div>
    <div>
        <label class="visually-hidden" for="dashboard-sort">Сортировка</label>
        <select id="dashboard-sort" class="form-select">
            <option value="name">По имени</option>
            <option value="status">По статусу</option>
            <option value="updated">По обновлению</option>
        </select>
    </div>
    <span class="dashboard-result-count" id="dashboard-result-count">
        Показано: {{ stats.total_servers }}
    </span>
</section>

<div id="dashboard-groups">
    {% for groupKey, group in groups %}
    {% set panelId = 'dashboard-group-' ~ loop.index %}
    <section class="dashboard-group" data-dashboard-group>
        <button type="button" class="dashboard-group-header"
                data-group-toggle="{{ groupKey }}"
                aria-expanded="true" aria-controls="{{ panelId }}">
            <span class="dashboard-group-title">
                <span class="dashboard-group-icon" aria-hidden="true">
                    <i class="fas {{ group.icon|default('fa-server')|replace({'fas ': ''}) }}"></i>
                </span>
                <span>{{ group.name }}</span>
            </span>
            <span class="dashboard-group-meta">
                <span class="dashboard-group-count" data-group-count>
                    {{ group.servers|length }}
                </span>
                <i class="fas fa-chevron-up dashboard-group-chevron" aria-hidden="true"></i>
            </span>
        </button>

        <div id="{{ panelId }}" class="dashboard-group-panel">
            <div class="server-grid" data-server-grid>
                {% for server in group.servers %}
                {% set disk_metric = server.latest_metrics['disk_used_root'] ?? server.latest_metrics['disk_used'] ?? null %}
                <article class="server-grid-item"
                         data-server-item
                         data-server-id="{{ server.id }}"
                         data-server-name="{{ server.name|lower }}"
                         data-server-status="{{ server.status }}"
                         data-last-update="{{ server.last_metrics_at ? server.last_metrics_at|date('U') : 0 }}">
                    <a href="/servers/{{ server.id }}"
                       class="server-card server-status-{{ server.status }}"
                       id="server-card-{{ server.id }}">
                        <div class="server-card-header">
                            <div class="server-identity">
                                {% include "partials/server-status-icon.twig" with {
                                    icon_container_class: 'server-status-icon',
                                    icon_id: 'status-icon-' ~ server.id
                                } %}
                                <div class="server-title-wrap">
                                    <h3 class="server-name" title="{{ server.name }}">
                                        {{ server.name }}
                                    </h3>
                                    <span class="server-status-label"
                                          id="status-label-{{ server.id }}">
                                        {{ status_labels[server.status] }}
                                    </span>
                                </div>
                            </div>
                            <span id="alert-count-{{ server.id }}"
                                  class="server-alert-count{% if server.active_alerts == 0 %} d-none{% endif %}">
                                <i class="fas fa-bell" aria-hidden="true"></i>
                                <span>{{ server.active_alerts }}</span>
                                <span class="visually-hidden">активных алертов</span>
                            </span>
                        </div>

                        <dl class="server-metrics">
                            <div class="server-metric">
                                <dt>CPU</dt>
                                <dd id="cpu-val-{{ server.id }}">
                                    {% if server.latest_metrics['cpu_load'] is defined %}
                                        {{ server.latest_metrics['cpu_load'].value|round(1) }}%
                                    {% else %}—{% endif %}
                                </dd>
                            </div>
                            <div class="server-metric">
                                <dt>RAM</dt>
                                <dd id="ram-val-{{ server.id }}">
                                    {% if server.latest_metrics['ram_used'] is defined %}
                                        {{ server.latest_metrics['ram_used'].value|round(1) }}%
                                    {% else %}—{% endif %}
                                </dd>
                            </div>
                            <div class="server-metric">
                                <dt>Диск</dt>
                                <dd id="disk-val-{{ server.id }}">
                                    {% if disk_metric is not null %}
                                        {{ disk_metric.value|round(1) }}%
                                    {% else %}—{% endif %}
                                </dd>
                            </div>
                        </dl>

                        <div class="server-card-footer">
                            {% if server.latest_metrics['uptime'] is defined %}
                            <span class="server-uptime">
                                <i class="fas fa-clock" aria-hidden="true"></i>
                                {% set uptime_sec = server.latest_metrics['uptime'].value %}
                                {% if uptime_sec >= 86400 %}
                                    {{ (uptime_sec / 86400)|round(0, 'floor') }} д
                                    {{ ((uptime_sec % 86400) / 3600)|round(0, 'floor') }} ч
                                {% elseif uptime_sec >= 3600 %}
                                    {{ (uptime_sec / 3600)|round(0, 'floor') }} ч
                                    {{ ((uptime_sec % 3600) / 60)|round(0, 'floor') }} мин
                                {% else %}
                                    {{ (uptime_sec / 60)|round(0, 'floor') }} мин
                                {% endif %}
                            </span>
                            {% else %}
                            <span class="server-uptime">Uptime: —</span>
                            {% endif %}
                            <time class="server-updated-at"
                                  id="updated-at-{{ server.id }}"
                                  {% if server.last_metrics_at %}
                                  datetime="{{ server.last_metrics_at|date('c') }}"
                                  {% endif %}>
                                {% if server.seconds_since_update is not null %}
                                    {{ server.seconds_since_update }} сек. назад
                                {% else %}
                                    обновлений нет
                                {% endif %}
                            </time>
                        </div>
                    </a>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endfor %}
</div>

<section id="dashboard-no-results" class="empty-state empty-state-compact" hidden>
    <span class="empty-state-icon" aria-hidden="true">
        <i class="fas fa-magnifying-glass"></i>
    </span>
    <h2>Серверы не найдены</h2>
    <p>Измените строку поиска или фильтр статуса.</p>
</section>

<p class="visually-hidden" id="dashboard-live-region" aria-live="polite"></p>
<script src="/js/dashboard.js" defer></script>
{% endif %}
{% endblock %}
