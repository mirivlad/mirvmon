{% extends "login-layout.twig" %}
{% set page_title = t('auth.setup.title') %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card">
            <div class="card-header">
                <h1 class="h3 text-center mb-0">{{ t('auth.setup.title') }}</h1>
            </div>
            <div class="card-body">
                <form method="post" action="/setup">
                    {% include "partials/csrf.twig" %}
                    <div class="mb-3">
                        <label for="setup_token" class="form-label">{{ t('auth.setup.token') }}</label>
                        <input type="password" class="form-control" id="setup_token" name="setup_token" required autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label for="username" class="form-label">{{ t('auth.login.username') }}</label>
                        <input type="text" class="form-control" id="username" name="username" minlength="3" maxlength="80" required autocomplete="username">
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">{{ t('auth.setup.email') }}</label>
                        <input type="email" class="form-control" id="email" name="email" maxlength="254" autocomplete="email">
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">{{ t('auth.login.password') }}</label>
                        <input type="password" class="form-control" id="password" name="password" minlength="12" required autocomplete="new-password">
                    </div>
                    <div class="mb-3">
                        <label for="password_confirmation" class="form-label">{{ t('auth.setup.password_confirm') }}</label>
                        <input type="password" class="form-control" id="password_confirmation" name="password_confirmation" minlength="12" required autocomplete="new-password">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">{{ t('auth.setup.submit') }}</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
