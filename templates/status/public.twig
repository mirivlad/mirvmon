<!DOCTYPE html>
<html lang="{{ current_locale() }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>{{ t('public_status.title') }} · MirvMon</title>
    <link rel="icon" type="image/svg+xml" href="/brand/mirvmon-mark.svg">
    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css?v={{ app_version|url_encode }}">
    <link rel="stylesheet" href="/css/app.css?v={{ app_version|url_encode }}">
</head>
<body>
<main class="container py-4 py-md-5">
    <header class="mb-4">
        <div class="app-brand mb-4">{% include 'partials/brand.twig' %}</div>
        <h1 class="h2">{{ t('public_status.title') }}</h1>
        <p class="text-muted">{{ t('public_status.subtitle') }}</p>
    </header>
    {% if items is empty %}
        <div class="card"><div class="card-body text-muted">{{ t('public_status.empty') }}</div></div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>{{ t('common.name') }}</th><th>{{ t('common.status') }}</th></tr></thead>
                    <tbody>
                    {% for item in items %}
                        {% set color = {'operational': 'success', 'degraded': 'warning', 'outage': 'danger', 'maintenance': 'secondary', 'unknown': 'secondary'}[item.status] %}
                        <tr>
                            <td class="fw-semibold">{{ item.display_name }}</td>
                            <td><span class="badge text-bg-{{ color }}">{{ t('public_status.state.' ~ item.status) }}</span></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
    <p class="small text-muted mt-3">{{ t('public_status.scope') }}</p>
</main>
</body>
</html>
