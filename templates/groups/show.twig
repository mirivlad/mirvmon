{% extends "layout.twig" %}
{% set page_title = group.name %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>
                <i class="fas {{ group.icon }}"></i> {{ group.name }}
                {% if group.description %}<small class="text-muted">- {{ group.description }}</small>{% endif %}
            </h2>
            <div>
                {% include "partials/action-button.twig" with {href: '/groups/' ~ group.id ~ '/edit', icon: 'fa-edit', label: t('common.edit'), class: 'btn-outline-primary'} %}
                {% include "partials/action-button.twig" with {href: '/groups', icon: 'fa-arrow-left', label: t('groups.back'), class: 'btn-outline-secondary'} %}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h4>{{ t('groups.info') }}</h4>
                <p><strong>{{ t('common.description') }}:</strong> {{ group.description|default(t('groups.no_description')) }}</p>
                <p><strong>{{ t('groups.column.color') }}:</strong>
                    {% if group.color %}
                    <span class="badge" style="background-color: {{ group.color }}">{{ group.color }}</span>
                    {% else %}{{ t('common.not_set') }}{% endif %}
                </p>
                <p><strong>{{ t('groups.servers_in_group', {count: servers|length}) }}</strong></p>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-server"></i> {{ t('groups.servers_title') }}</h4>
            </div>
            <div class="card-body">
                {% if servers|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead><tr>
                            <th>{{ t('common.name') }}</th>
                            <th>{{ t('common.address') }}</th>
                            <th>{{ t('servers.column.last_metrics') }}</th>
                            <th>{{ t('common.status') }}</th>
                            <th>{{ t('common.actions') }}</th>
                        </tr></thead>
                        <tbody>
                            {% for server in servers %}
                            <tr>
                                <td><strong>{{ server.name }}</strong></td>
                                <td>{{ server.address|default('-') }}</td>
                                <td>{% if server.last_metrics_at %}{{ server.last_metrics_at|date('d.m.Y H:i:s') }}{% else %}{{ t('common.no_data') }}{% endif %}</td>
                                <td>
                                    {% set status_class = server.status == 'online' ? 'success' : (server.status == 'warning' ? 'warning text-dark' : (server.status == 'critical' ? 'danger' : 'secondary')) %}
                                    <span class="badge bg-{{ status_class }}">{{ t('status.' ~ server.status) }}</span>
                                </td>
                                <td>{% include "partials/action-button.twig" with {href: '/servers/' ~ server.id, icon: 'fa-eye', label: t('common.view'), class: 'btn-primary'} %}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-server fa-3x text-muted mb-3"></i>
                    <p class="lead">{{ t('groups.empty_group') }}</p>
                    <a href="/servers/create" class="btn btn-primary"><i class="fas fa-plus"></i> {{ t('servers.add') }}</a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
