{% extends "layout.twig" %}
{% set page_title = group.name %}

{% block content %}
<header class="app-page-header">
    <div class="app-page-header-main">
        <h1>
            <i class="fas {{ group.icon|default('fa-box') }}" {% if group.color %}style="color: {{ group.color }}"{% endif %} aria-hidden="true"></i>
            {{ group.name }}
        </h1>
        <p class="page-subtitle">{{ group.description|default(t('groups.no_description')) }}</p>
    </div>
    <div class="app-page-actions">
        {% if session.role == 'admin' %}
        <a href="/groups/{{ group.id }}/edit" class="btn btn-outline-primary">
            <i class="fas fa-edit" aria-hidden="true"></i> {{ t('common.edit') }}
        </a>
        {% endif %}
        <a href="/groups" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> {{ t('groups.back') }}
        </a>
    </div>
</header>

<div data-live-fragment="group-operational" data-live-interval-ms="15000">
<section aria-labelledby="group-summary-title">
    <h2 class="visually-hidden" id="group-summary-title">{{ t('ui19.groups.summary') }}</h2>
    <div class="group-summary-grid">
        <div class="group-summary-card">
            <span class="summary-label">{{ t('ui19.groups.total') }}</span>
            <strong class="summary-value">{{ summary.total }}</strong>
        </div>
        <div class="group-summary-card">
            <span class="summary-label">{{ t('status.online') }}</span>
            <strong class="summary-value text-success">{{ summary.online }}</strong>
        </div>
        <div class="group-summary-card">
            <span class="summary-label">{{ t('status.warning') }}</span>
            <strong class="summary-value text-warning">{{ summary.warning }}</strong>
        </div>
        <div class="group-summary-card">
            <span class="summary-label">{{ t('status.critical') }}</span>
            <strong class="summary-value text-danger">{{ summary.critical }}</strong>
        </div>
        <div class="group-summary-card">
            <span class="summary-label">{{ t('status.offline') }}</span>
            <strong class="summary-value text-secondary">{{ summary.offline }}</strong>
        </div>
        <div class="group-summary-card">
            <span class="summary-label">{{ t('ui19.groups.active_problems') }}</span>
            <strong class="summary-value">{{ summary.active_problems }}</strong>
        </div>
        <div class="group-summary-card">
            <span class="summary-label">{{ t('ui19.groups.websites') }}</span>
            <strong class="summary-value">{{ summary.website_total }}</strong>
        </div>
    </div>
</section>

<section class="app-panel" aria-labelledby="group-websites-title">
    <div class="app-panel-header">
        <h2 class="app-panel-title" id="group-websites-title">
            <i class="fas fa-globe" aria-hidden="true"></i> {{ t('ui19.groups.websites') }}
        </h2>
        <span class="badge bg-light text-dark">{{ websites|length }}</span>
    </div>
    {% if websites|length > 0 %}
    <div class="table-responsive">
        <table class="table app-table server-list-table">
            <thead><tr><th>{{ t('common.name') }}</th><th>{{ t('websites.filters.status') }}</th><th>{{ t('common.actions') }}</th></tr></thead>
            <tbody>
            {% for website in websites %}
                <tr>
                    <td data-label="{{ t('common.name') }}">
                        <a class="server-list-name" href="/sites/{{ website.id }}">{{ website.name }}</a>
                        <span class="server-list-secondary">{{ website.primary_url|default('—') }}</span>
                    </td>
                    <td data-label="{{ t('websites.filters.status') }}">
                        <span class="app-status-badge status-{{ website.status }}"><span class="app-status-dot" aria-hidden="true"></span>{{ t('websites.status.' ~ website.status) }}</span>
                        {% if website.active_problem_count > 0 %}<span class="small text-danger ms-1">{{ website.active_problem_count }}</span>{% endif %}
                    </td>
                    <td data-label="{{ t('common.actions') }}">
                        {% include "partials/action-button.twig" with {href: '/sites/' ~ website.id, icon: 'fa-eye', label: t('common.view'), class: 'btn-primary'} %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="app-empty-state">
        <span class="app-empty-state-icon"><i class="fas fa-globe" aria-hidden="true"></i></span>
        <h3>{{ t('ui19.groups.no_websites') }}</h3>
        <p>{{ t('ui19.groups.no_websites_text') }}</p>
        {% if session.role == 'admin' %}<a href="/sites/create" class="btn btn-primary">{{ t('website.create') }}</a>{% endif %}
    </div>
    {% endif %}
</section>

<section class="app-panel" aria-labelledby="group-servers-title">
    <div class="app-panel-header">
        <h2 class="app-panel-title" id="group-servers-title">
            <i class="fas fa-server" aria-hidden="true"></i> {{ t('ui19.groups.servers') }}
        </h2>
        <span class="badge bg-light text-dark">{{ t('groups.servers_in_group', {count: servers|length}) }}</span>
    </div>

    {% if servers|length > 0 %}
    <div class="table-responsive">
        <table class="table app-table server-list-table">
            <thead>
                <tr>
                    <th>{{ t('ui19.servers.server') }}</th>
                    <th>{{ t('ui19.servers.health') }}</th>
                    <th>{{ t('common.actions') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for server in servers %}
                <tr>
                    <td data-label="{{ t('ui19.servers.server') }}">
                        <div class="server-list-identity server-status-{{ server.status }}">
                            {% include "partials/server-status-icon.twig" %}
                            <div class="server-list-primary">
                                <a class="server-list-name" href="/servers/{{ server.id }}">{{ server.name }}</a>
                                <span class="server-list-secondary">
                                    {{ server.address|default('—') }}
                                    {% if server.description %} · {{ server.description }}{% endif %}
                                </span>
                            </div>
                        </div>
                    </td>
                    <td data-label="{{ t('ui19.servers.health') }}">
                        <span class="app-status-badge status-{{ server.status }}">
                            <span class="app-status-dot" aria-hidden="true"></span>
                            {{ t('status.' ~ server.status) }}
                        </span>
                        <span class="server-list-secondary">
                            {% if server.last_metrics_at %}
                                {{ t('ui19.servers.last_sample', {time: server.last_metrics_at|date('d.m.Y H:i:s')}) }}
                            {% else %}
                                {{ t('ui19.servers.no_sample') }}
                            {% endif %}
                        </span>
                    </td>
                    <td data-label="{{ t('common.actions') }}">
                        {% include "partials/action-button.twig" with {href: '/servers/' ~ server.id, icon: 'fa-eye', label: t('common.view'), class: 'btn-primary'} %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="app-empty-state">
        <span class="app-empty-state-icon"><i class="fas fa-server" aria-hidden="true"></i></span>
        <h3>{{ t('groups.empty_group') }}</h3>
        <p>{{ t('ui19.groups.no_problems') }}</p>
        {% if session.role == 'admin' %}
        <a href="/servers/create" class="btn btn-primary">
            <i class="fas fa-plus" aria-hidden="true"></i> {{ t('servers.add') }}
        </a>
        {% endif %}
    </div>
    {% endif %}
</section>
</div>
{% endblock %}
