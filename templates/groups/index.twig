{% extends "layout.twig" %}
{% set page_title = t('groups.title') %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2><i class="fas fa-layer-group"></i> {{ t('groups.title') }}</h2>
            <a href="/groups/create" class="btn btn-primary">
                <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">{{ t('groups.create') }}</span>
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                {% if groups|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead><tr>
                            <th>{{ t('common.name') }}</th>
                            <th>{{ t('common.description') }}</th>
                            <th>{{ t('groups.column.servers') }}</th>
                            <th>{{ t('groups.column.color') }}</th>
                            <th>{{ t('common.actions') }}</th>
                        </tr></thead>
                        <tbody>
                            {% for group in groups %}
                            <tr>
                                <td><i class="fas {{ group.icon|default('fa-box') }}" {% if group.color %}style="color: {{ group.color }}"{% endif %}></i> {{ group.name }}</td>
                                <td>{{ group.description|default('') }}</td>
                                <td>{{ group.server_count }}</td>
                                <td>{% if group.color %}<span class="badge" style="background-color: {{ group.color }}">{{ group.color }}</span>{% else %}-{% endif %}</td>
                                <td>
                                    {% include "partials/action-button.twig" with {href: '/groups/' ~ group.id, icon: 'fa-eye', label: t('common.view'), class: 'btn-outline-info'} %}
                                    {% include "partials/action-button.twig" with {href: '/groups/' ~ group.id ~ '/edit', icon: 'fa-edit', label: t('common.edit'), class: 'btn-outline-primary'} %}
                                    {% include "partials/action-button.twig" with {form_action: '/groups/' ~ group.id ~ '/delete', icon: 'fa-trash', label: t('common.delete'), class: 'btn-outline-danger', confirm: t('groups.delete.confirm')} %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-layer-group fa-3x text-muted mb-3"></i>
                    <p class="lead">{{ t('groups.empty.heading') }}</p>
                    <a href="/groups/create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> {{ t('groups.empty.create') }}
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
